__PM_SCRIPT__
$ErrorActionPreference='Stop'
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$Product='Planificador Multifamiliar'
$ProductId='planificador-multifamiliar'
$ExpectedOldVersion='7.4.55'
$ExpectedVersion='7.4.56'
$ExpectedPayloadSha='7B286F80ADFB5E5F1BB885B7401EF4BAF61280673973472EA639CF27D242A442'
$Port=4173
$Self=$env:PM_INSTALLER_SELF
$Root=Join-Path $env:LOCALAPPDATA 'PlanificadorMultifamiliar'
$App=Join-Path $Root 'App'
$Data=Join-Path $Root 'Data'
$Backups=Join-Path $Root 'Backups'
$AppBackups=Join-Path $Backups 'App'
$DataBackups=Join-Path $Backups 'Data'
New-Item -ItemType Directory -Force -Path $Root,$Data,$Backups,$AppBackups,$DataBackups | Out-Null

[System.Windows.Forms.Application]::EnableVisualStyles()
$f=New-Object Windows.Forms.Form
$f.Text="$Product · Actualización V$ExpectedVersion"
$f.Width=760;$f.Height=470;$f.StartPosition='CenterScreen';$f.FormBorderStyle='FixedDialog';$f.MaximizeBox=$false;$f.MinimizeBox=$false;$f.ControlBox=$false
$title=New-Object Windows.Forms.Label;$title.Left=28;$title.Top=22;$title.Width=680;$title.Height=38;$title.Font=New-Object Drawing.Font('Segoe UI',17,[Drawing.FontStyle]::Bold);$title.Text=$Product
$sub=New-Object Windows.Forms.Label;$sub.Left=30;$sub.Top=66;$sub.Width=680;$sub.Height=25;$sub.Font=New-Object Drawing.Font('Segoe UI',10);$sub.Text="V$ExpectedOldVersion → V$ExpectedVersion · Data y Backups se conservan"
$status=New-Object Windows.Forms.Label;$status.Left=30;$status.Top=108;$status.Width=680;$status.Height=38;$status.Font=New-Object Drawing.Font('Segoe UI',10,[Drawing.FontStyle]::Bold);$status.Text='Preparando actualización…'
$bar=New-Object Windows.Forms.ProgressBar;$bar.Left=30;$bar.Top=150;$bar.Width=680;$bar.Height=20;$bar.Minimum=0;$bar.Maximum=100
$detail=New-Object Windows.Forms.TextBox;$detail.Left=30;$detail.Top=188;$detail.Width=680;$detail.Height=175;$detail.Multiline=$true;$detail.ReadOnly=$true;$detail.ScrollBars='Vertical';$detail.BackColor=[Drawing.Color]::White;$detail.Font=New-Object Drawing.Font('Consolas',9);$detail.Text='La instalación todavía no ha sido modificada.'
$btnCopy=New-Object Windows.Forms.Button;$btnCopy.Left=30;$btnCopy.Top=382;$btnCopy.Width=125;$btnCopy.Height=32;$btnCopy.Text='Copiar detalle';$btnCopy.Visible=$false
$btnSave=New-Object Windows.Forms.Button;$btnSave.Left=165;$btnSave.Top=382;$btnSave.Width=125;$btnSave.Height=32;$btnSave.Text='Guardar detalle';$btnSave.Visible=$false
$btnBackup=New-Object Windows.Forms.Button;$btnBackup.Left=300;$btnBackup.Top=382;$btnBackup.Width=135;$btnBackup.Height=32;$btnBackup.Text='Abrir respaldos';$btnBackup.Visible=$false
$btnClose=New-Object Windows.Forms.Button;$btnClose.Left=585;$btnClose.Top=382;$btnClose.Width=125;$btnClose.Height=32;$btnClose.Text='Cerrar';$btnClose.Visible=$false
$f.Controls.AddRange(@($title,$sub,$status,$bar,$detail,$btnCopy,$btnSave,$btnBackup,$btnClose))
$btnCopy.Add_Click({try{[Windows.Forms.Clipboard]::SetText([string]$detail.Text)}catch{}})
$btnSave.Add_Click({try{$dlg=New-Object Windows.Forms.SaveFileDialog;$dlg.FileName=('Actualizacion_V'+$ExpectedVersion+'_detalle_'+(Get-Date -Format 'yyyyMMdd_HHmmss')+'.txt');$dlg.Filter='Texto (*.txt)|*.txt';if($dlg.ShowDialog() -eq [Windows.Forms.DialogResult]::OK){[IO.File]::WriteAllText($dlg.FileName,[string]$detail.Text,[Text.UTF8Encoding]::new($false))}}catch{}})
$btnBackup.Add_Click({try{Start-Process explorer.exe -ArgumentList ('"'+$Backups+'"')}catch{}})
$btnClose.Add_Click({$f.Close()})
$f.Show();[Windows.Forms.Application]::DoEvents()

function Step([int]$p,[string]$s,[string]$d=''){
  $bar.Value=[Math]::Max(0,[Math]::Min(100,$p));$status.Text=$s;if($d){$detail.Text=$d};[Windows.Forms.Application]::DoEvents()
}
function Sha([string]$p){return (Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToUpperInvariant()}
function Finish([bool]$ok,[string]$s,[string]$d){
  $bar.Value=if($ok){100}else{[Math]::Min(99,$bar.Value)};$status.Text=$s;$detail.Text=$d;$detail.SelectionStart=0;$detail.SelectionLength=0
  if($ok){$status.ForeColor=[Drawing.Color]::FromArgb(35,115,65)}else{$status.ForeColor=[Drawing.Color]::FromArgb(174,38,58)}
  $btnCopy.Visible=$true;$btnSave.Visible=$true;$btnBackup.Visible=$true;$btnClose.Visible=$true;$f.ControlBox=$true;[Windows.Forms.Application]::DoEvents()
}
function Wait-Form {while($f.Visible){[Windows.Forms.Application]::DoEvents();Start-Sleep -Milliseconds 80}}
function Remove-DirWithRetry([string]$dir,[int]$retries=6){
  if(-not(Test-Path -LiteralPath $dir)){return}
  for($i=1;$i -le $retries;$i++){try{Remove-Item -LiteralPath $dir -Recurse -Force -ErrorAction Stop;return}catch{if($i -eq $retries){throw "No se pudo limpiar $dir tras $retries intentos: $($_.Exception.Message)"};Start-Sleep -Milliseconds (500*$i)}}
}
function Copy-Tree([string]$src,[string]$dst){New-Item -ItemType Directory -Force -Path $dst|Out-Null;Get-ChildItem -LiteralPath $src -Force|ForEach-Object{Copy-Item -LiteralPath $_.FullName -Destination $dst -Recurse -Force}}
function Verify-App([string]$dir){
  foreach($required in @('app.js','index.html','styles.css','servidor_local.ps1','PLANIFICADOR_LAUNCHER.ps1','PLANIFICADOR_SUPERVISOR.ps1','VERSION.txt','manifest.webmanifest','sw.js','ui_models.js','ui_system.css','INSTALLATION_INTEGRITY.json','ACTUALIZAR_POSTGRESQL_V7_4_49.sql')){if(-not(Test-Path -LiteralPath (Join-Path $dir $required) -PathType Leaf)){throw "Paquete incompleto: $required"}}
  $vf=Join-Path $dir 'VERSION.txt';$v=Get-Content -LiteralPath $vf -Raw;if($v -notmatch ('V'+[regex]::Escape($ExpectedVersion)+'(?:\s|$)')){throw "VERSION.txt no corresponde a V$ExpectedVersion. Contenido: $v"}
  $mf=Join-Path $dir 'INSTALLATION_INTEGRITY.json';try{$j=Get-Content -LiteralPath $mf -Raw|ConvertFrom-Json}catch{throw ('No se pudo leer INSTALLATION_INTEGRITY.json: '+$_.Exception.Message)}
  if([string]$j.productId -ne $ProductId -or [string]$j.version -ne $ExpectedVersion -or [string]$j.algorithm -ne 'SHA256'){throw 'Manifest de integridad de otro producto o versión.'}
  $count=0;foreach($prop in $j.files.PSObject.Properties){$rel=[string]$prop.Name;$want=([string]$prop.Value).ToUpperInvariant();$file=Join-Path $dir ($rel -replace '/','\');if(-not(Test-Path -LiteralPath $file -PathType Leaf)){throw "Archivo faltante: $rel"};$got=Sha $file;if($got -ne $want){throw "Hash incorrecto: $rel"};$count++}
  if($j.fileCount -and [int]$j.fileCount -ne $count){throw "Conteo de integridad incorrecto: $count de $($j.fileCount)"}
  return $count
}
function Get-AppWindows {
  try{return @(Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{($_.Name -match '^(msedge|chrome|brave)\.exe$') -and ([string]$_.CommandLine -match '(?i)127\.0\.0\.1:4173') -and ([string]$_.CommandLine -match '(?i)--app=|launcher=')})}catch{return @()}
}
function Wait-ForAppWindowsToClose {
  while($true){$wins=Get-AppWindows;if(-not $wins.Count){return};$r=[Windows.Forms.MessageBox]::Show("Hay $($wins.Count) ventana(s) del Planificador abiertas.`n`nGuarde cualquier edición y cierre completamente esas ventanas. Después pulse Reintentar.`n`nCancelar no modifica la instalación.",'Planificador abierto',[Windows.Forms.MessageBoxButtons]::RetryCancel,[Windows.Forms.MessageBoxIcon]::Warning);if($r -eq [Windows.Forms.DialogResult]::Cancel){throw 'Actualización cancelada por el usuario. No se modificó la instalación.'}}
}
function Stop-LocalRuntime {
  try{Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{($_.Name -match '^(powershell|pwsh|cmd)\.exe$') -and ([string]$_.CommandLine -match '(?i)PLANIFICADOR_SUPERVISOR\.ps1') -and ([string]$_.CommandLine).IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0}|ForEach-Object{Stop-Process -Id ([int]$_.ProcessId) -Force -ErrorAction SilentlyContinue}}catch{}
  try{$h=Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/health" -Method Get -TimeoutSec 2 -ErrorAction Stop;if($h.ok -and [string]$h.productId -eq $ProductId -and $h.serverPid -and $h.appRoot -and [IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App) -and $h.appRoot -and [IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App) -and $h.appRoot -and [IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App) -and $h.appRoot -and [IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App) -and $h.appRoot -and [IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App)){Stop-Process -Id ([int]$h.serverPid) -Force -ErrorAction SilentlyContinue}}catch{}
  try{Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{($_.Name -match '^(powershell|pwsh|cmd)\.exe$') -and ([string]$_.CommandLine -match '(?i)servidor_local\.ps1') -and ([string]$_.CommandLine).IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0}|ForEach-Object{Stop-Process -Id ([int]$_.ProcessId) -Force -ErrorAction SilentlyContinue}}catch{}
  Start-Sleep -Milliseconds 1000
}
function Start-Supervisor([string]$appPath=$App){
  $sup=Join-Path $appPath 'PLANIFICADOR_SUPERVISOR.ps1';$psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe';if(-not(Test-Path -LiteralPath $sup)){throw 'Falta PLANIFICADOR_SUPERVISOR.ps1.'};$args='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$sup+'"';Start-Process -FilePath $psExe -ArgumentList $args -WindowStyle Hidden|Out-Null
}
function Start-Launcher([string]$appPath=$App){
  $launcher=Join-Path $appPath 'PLANIFICADOR_LAUNCHER.ps1';$psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe';if(Test-Path -LiteralPath $launcher){$args='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'" -RefreshInterface';Start-Process -FilePath $psExe -ArgumentList $args -WindowStyle Hidden|Out-Null}
}
function Wait-Health([string]$version,[int]$seconds=35){
  $deadline=(Get-Date).AddSeconds($seconds);do{Start-Sleep -Milliseconds 500;try{$h=Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/health" -Method Get -TimeoutSec 2 -ErrorAction Stop;if($h.ok -and [string]$h.productId -eq $ProductId -and [string]$h.appVersion -eq $version -and $h.appRoot){if([IO.Path]::GetFullPath([string]$h.appRoot) -eq [IO.Path]::GetFullPath($App)){return $true}}}catch{}}while((Get-Date) -lt $deadline);return $false
}
function Read-EmbeddedPayload {
  $raw=[IO.File]::ReadAllText($Self,[Text.Encoding]::UTF8) -replace "`r`n","`n";$marker="`n__PM_PAYLOAD__`n";$idx=$raw.LastIndexOf($marker,[StringComparison]::Ordinal);if($idx -lt 0){throw 'Instalador incompleto: no se encontró el payload.'};$b64=($raw.Substring($idx+$marker.Length) -replace '\s','');if($b64.Length -lt 1000){throw 'Instalador incompleto: payload vacío.'};return $b64
}

$temp=$null;$extract=$null;$newApp=$null;$rollbackDir=$null;$rollbackReady=$false;$runtimeStopped=$false;$appBackup=$null;$dataBackup=$null;$exitCode=1
try{
  Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction Stop
  Step 4 'Verificando paquete…' 'Leyendo y validando el payload antes de tocar la instalación.'
  $temp=Join-Path $env:TEMP ('PM7456_'+[guid]::NewGuid().ToString('N'));New-Item -ItemType Directory -Force -Path $temp|Out-Null;$zip=Join-Path $temp 'payload.zip'
  $b64=Read-EmbeddedPayload;try{[IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($b64))}catch{throw 'El payload Base64 está dañado o incompleto.'}
  $gotPayload=Sha $zip;if($gotPayload -ne $ExpectedPayloadSha){throw "El paquete embebido está dañado. SHA esperado $ExpectedPayloadSha; obtenido $gotPayload. No se modificó la instalación."}
  $extract=Join-Path $temp 'payload';Expand-Archive -LiteralPath $zip -DestinationPath $extract -Force;$fileCount=Verify-App $extract
  Step 16 "Paquete verificado ($fileCount archivos)" 'Comprobando la versión instalada y esperando el cierre seguro de la aplicación.'
  if(-not(Test-Path -LiteralPath $App -PathType Container)){throw 'No existe la instalación actual del Planificador.'};$oldVf=Join-Path $App 'VERSION.txt';if(-not(Test-Path -LiteralPath $oldVf)){throw 'La instalación actual no contiene VERSION.txt.'};$oldText=Get-Content -LiteralPath $oldVf -Raw;if($oldText -notmatch '\bV(\d+\.\d+\.\d+)\s*$'){throw "VERSION.txt no identifica una versión válida: $oldText"};$installedVersion=$Matches[1];if($installedVersion -notin @('7.4.48','7.4.49','7.4.50','7.4.51','7.4.52','7.4.53','7.4.54','7.4.55','7.4.56')){throw "Este instalador admite V7.4.48 a V7.4.56. Versión actual: $installedVersion"};$ExpectedOldVersion=$installedVersion
  Wait-ForAppWindowsToClose
  Step 26 'Deteniendo servicio local…' 'Solo se detendrán el supervisor y el servidor del Planificador de este usuario.';Stop-LocalRuntime;$runtimeStopped=$true
  Step 36 'Creando respaldo recuperable…' 'Respaldando App y Data antes de reemplazar archivos.'
  $stamp=Get-Date -Format 'yyyyMMdd_HHmmss_fff';$appBackup=Join-Path $AppBackups ("App_pre_V${ExpectedOldVersion}_$stamp.zip");[IO.Compression.ZipFile]::CreateFromDirectory($App,$appBackup,[IO.Compression.CompressionLevel]::Optimal,$false)
  if(Test-Path -LiteralPath $Data -PathType Container){$dataBackup=Join-Path $DataBackups ("Data_pre_V${ExpectedVersion}_$stamp.zip");[IO.Compression.ZipFile]::CreateFromDirectory($Data,$dataBackup,[IO.Compression.CompressionLevel]::Optimal,$false)}
  $stateFile=Join-Path $Data 'project_state.json';if(Test-Path -LiteralPath $stateFile){Copy-Item -LiteralPath $stateFile -Destination (Join-Path $DataBackups ("project_state_pre_V${ExpectedVersion}_$stamp.json")) -Force}
  $syncFile=Join-Path $Data 'sync_config.json';if(Test-Path -LiteralPath $syncFile){Copy-Item -LiteralPath $syncFile -Destination (Join-Path $DataBackups ("sync_config_pre_V${ExpectedVersion}_$stamp.json")) -Force}
  Step 52 'Preparando V7.4.56…' 'Copiando la nueva App a un staging independiente y verificándola otra vez.'
  $newApp=Join-Path $Root ('App_new_'+[guid]::NewGuid().ToString('N'));Copy-Tree $extract $newApp;$null=Verify-App $newApp
  Step 67 'Sustituyendo aplicación…' 'Data no se toca. La App anterior queda disponible para rollback hasta completar la prueba HTTP.'
  $rollbackDir=Join-Path $Root ('App_rollback_'+[guid]::NewGuid().ToString('N'));Move-Item -LiteralPath $App -Destination $rollbackDir -Force;$rollbackReady=$true;Move-Item -LiteralPath $newApp -Destination $App -Force;$newApp=$null;$null=Verify-App $App
  Step 80 'Iniciando V7.4.56…' 'Arrancando el servidor local y comprobando producto, versión y ruta en http://127.0.0.1:4173/api/health.'
  Start-Supervisor $App;if(-not(Wait-Health $ExpectedVersion 40)){throw "La verificación HTTP local no confirmó V$ExpectedVersion en el puerto $Port."}
  Step 94 'Verificación final correcta' 'V7.4.56 respondió correctamente. Finalizando la actualización y conservando los respaldos.'
  $cacheFolder=Join-Path $Root 'Updates';New-Item -ItemType Directory -Force -Path $cacheFolder|Out-Null
  $cacheName='Instalador_Actualizador_Planificador_Multifamiliar_V'+$ExpectedVersion.Replace('.','_')+'.cmd'
  $cacheTarget=Join-Path $cacheFolder $cacheName;$cacheStaging=Join-Path $cacheFolder ('pending_'+[guid]::NewGuid().ToString('N')+'.cmd')
  Copy-Item -LiteralPath $Self -Destination $cacheStaging -Force;if((Sha $Self) -ne (Sha $cacheStaging)){throw 'No se pudo verificar el instalador en caché.'};Move-Item -LiteralPath $cacheStaging -Destination $cacheTarget -Force
  if($rollbackReady -and (Test-Path -LiteralPath $rollbackDir)){Remove-DirWithRetry $rollbackDir 6;$rollbackReady=$false}
  try{Start-Launcher $App}catch{}
  $msg="ACTUALIZACIÓN COMPLETADA`r`n`r`nVersión instalada: V$ExpectedVersion`r`nServidor local: OK · puerto $Port`r`nRespaldo App: $appBackup`r`n"+$(if($dataBackup){"Respaldo Data: $dataBackup`r`n"}else{''})+"`r`nPostgreSQL: V7.4.56 no requiere un parche nuevo. Reutiliza la infraestructura de reservas V7.4.49 ya aplicada."
  Finish $true 'Actualización V7.4.56 completada y verificada.' $msg;$exitCode=0
}
catch{
  $err=$_.Exception.Message;$trace=$_.ScriptStackTrace;$rollback='';
  try{
    if($rollbackReady -and (Test-Path -LiteralPath $rollbackDir)){
      Step 88 ("Error detectado · restaurando V$ExpectedOldVersion…") 'La instalación nueva no fue aprobada. Se ejecuta rollback automático de App.';Stop-LocalRuntime;if(Test-Path -LiteralPath $App){Remove-DirWithRetry $App 5};Move-Item -LiteralPath $rollbackDir -Destination $App -Force;$rollbackReady=$false;Start-Supervisor $App;$okOld=Wait-Health $ExpectedOldVersion 35;$rollback=if($okOld){"Rollback V${ExpectedOldVersion}: OK"}else{"Rollback de archivos realizado, pero el servidor V$ExpectedOldVersion no respondió. Revise logs/respaldos."}
    }elseif($runtimeStopped -and (Test-Path -LiteralPath $App)){
      try{Start-Supervisor $App;$okOld=Wait-Health $ExpectedOldVersion 25;$rollback=if($okOld){"Instalación anterior reiniciada: OK"}else{'La instalación no había sido sustituida, pero el servidor no respondió al reinicio.'}}catch{$rollback='La instalación no había sido sustituida. No se pudo reiniciar automáticamente: '+$_.Exception.Message}
    }else{$rollback='La instalación no había sido modificada.'}
  }catch{$rollback='ATENCIÓN: el rollback encontró un error: '+$_.Exception.Message}
  $full="ERROR DURANTE LA ACTUALIZACIÓN`r`n`r`n$err`r`n`r`n$rollback`r`n`r`nDetalle técnico:`r`n$trace`r`n`r`nRespaldos: $Backups"
  Finish $false 'Error durante la actualización. El detalle queda visible.' $full;$exitCode=1
}
finally{
  try{if($newApp -and (Test-Path -LiteralPath $newApp)){Remove-DirWithRetry $newApp 3}}catch{}
  try{if($temp -and (Test-Path -LiteralPath $temp)){Remove-DirWithRetry $temp 3}}catch{}
}
Wait-Form
exit $exitCode

__PM_END_SCRIPT__
