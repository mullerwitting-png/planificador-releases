@echo off
setlocal
set "PM_INSTALLER_SELF=%~f0"
powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:PM_INSTALLER_SELF); $m=[regex]::Match($s,'(?s)\r?\n__PM_SCRIPT__\r?\n(.*?)\r?\n__PM_END_SCRIPT__'); if(-not $m.Success){throw 'Instalador incompleto'}; try { & ([scriptblock]::Create($m.Groups[1].Value)) } catch { $detail=$_ | Out-String; $path=Join-Path $env:TEMP 'Planificador_instalacion_error.txt'; [IO.File]::WriteAllText($path,$detail); try { Add-Type -AssemblyName System.Windows.Forms; $f=New-Object Windows.Forms.Form; $f.Text='Planificador Multifamiliar · Error de actualización'; $f.Width=850; $f.Height=520; $f.StartPosition='CenterScreen'; $box=New-Object Windows.Forms.TextBox; $box.Multiline=$true; $box.ReadOnly=$true; $box.ScrollBars='Both'; $box.Dock='Fill'; $box.Text=$detail; $panel=New-Object Windows.Forms.FlowLayoutPanel; $panel.Dock='Bottom'; $panel.Height=45; $copy=New-Object Windows.Forms.Button; $copy.Text='Copiar detalle'; $copy.Add_Click({[Windows.Forms.Clipboard]::SetText($box.Text)}); $save=New-Object Windows.Forms.Button; $save.Text='Guardar detalle'; $save.Add_Click({$d=New-Object Windows.Forms.SaveFileDialog; $d.FileName='Detalle_actualizacion.txt'; if($d.ShowDialog() -eq 'OK'){[IO.File]::WriteAllText($d.FileName,$box.Text)}}); $panel.Controls.Add($copy); $panel.Controls.Add($save); $f.Controls.Add($box); $f.Controls.Add($panel); [void]$f.ShowDialog() } catch {}; exit 1 }"
set "PM_RC=%errorlevel%"
exit /b %PM_RC%
__PM_SCRIPT__
$ErrorActionPreference='Stop'
$env:PSModulePath=(Join-Path $PSHOME 'Modules')+';'+$env:PSModulePath
Import-Module Microsoft.PowerShell.Utility,Microsoft.PowerShell.Management,Microsoft.PowerShell.Archive -ErrorAction Stop
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName System.Security

$Product='Planificador Multifamiliar'
$ProductId='planificador-multifamiliar'
$NewVersion=[version]'7.4.21'
$ExpectedVersion='7.4.21'
$Port=4173
$Self=$env:PM_INSTALLER_SELF
if([string]::IsNullOrWhiteSpace($Self) -or -not (Test-Path -LiteralPath $Self)){ throw 'No se pudo localizar el instalador.' }

$Root=Join-Path $env:LOCALAPPDATA 'PlanificadorMultifamiliar'
# Validation-only mode never touches the installed application, registry or shortcuts.
if($env:PM_VALIDATE_ONLY -eq '1'){
  $Root=Join-Path (Split-Path -Parent $Self) '.validation-only'
}
$App=Join-Path $Root 'App'
$Data=Join-Path $Root 'Data'
$Backups=Join-Path $Root 'Backups'
$AppBackups=Join-Path $Backups 'App'
$DataBackups=Join-Path $Backups 'Data'
$LocalUpdates=Join-Path $Root 'Updates'
$BindingFile=Join-Path $Data 'installation_binding.bin'
$BindingInfoFile=Join-Path $Data 'installation_binding.json'
New-Item -ItemType Directory -Path $Root,$Data,$Backups,$AppBackups,$DataBackups,$LocalUpdates -Force | Out-Null

# Interfaz de actualización: la consola conserva diagnóstico, pero el flujo normal usa una ventana moderna.
$script:SetupForm=$null;$script:SetupProgress=$null;$script:SetupStatus=$null;$script:SetupDetail=$null
function Initialize-SetupUi {
  try {
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $f=New-Object System.Windows.Forms.Form;$f.Text="$Product · Actualización V$ExpectedVersion";$f.Width=680;$f.Height=355;$f.StartPosition='CenterScreen';$f.FormBorderStyle='FixedDialog';$f.MaximizeBox=$false;$f.MinimizeBox=$true;$f.TopMost=$false
    $title=New-Object System.Windows.Forms.Label;$title.Left=28;$title.Top=25;$title.Width=600;$title.Height=34;$title.Font=New-Object Drawing.Font('Segoe UI',17,[Drawing.FontStyle]::Bold);$title.Text='Planificador Multifamiliar'
    $ver=New-Object System.Windows.Forms.Label;$ver.Left=30;$ver.Top=66;$ver.Width=600;$ver.Height=24;$ver.Font=New-Object Drawing.Font('Segoe UI',10);$ver.Text="Actualizando a V$ExpectedVersion · sus datos y respaldos se conservan"
    $status=New-Object System.Windows.Forms.Label;$status.Left=30;$status.Top=118;$status.Width=600;$status.Height=42;$status.Font=New-Object Drawing.Font('Segoe UI',10,[Drawing.FontStyle]::Bold);$status.Text='Preparando actualización…'
    $bar=New-Object System.Windows.Forms.ProgressBar;$bar.Left=30;$bar.Top=165;$bar.Width=600;$bar.Height=18;$bar.Minimum=0;$bar.Maximum=100;$bar.Value=0
    $detail=New-Object System.Windows.Forms.TextBox;$detail.Left=30;$detail.Top=205;$detail.Width=600;$detail.Height=78;$detail.Multiline=$true;$detail.ReadOnly=$true;$detail.ScrollBars='Vertical';$detail.BackColor=[Drawing.Color]::White;$detail.Text='La instalación todavía no ha modificado la versión actual.'
    $f.Controls.AddRange(@($title,$ver,$status,$bar,$detail));$script:SetupForm=$f;$script:SetupProgress=$bar;$script:SetupStatus=$status;$script:SetupDetail=$detail;$f.Show();[System.Windows.Forms.Application]::DoEvents()
  } catch {}
}
function Set-SetupUi([int]$pct,[string]$message,[string]$detail='') {
  try { if($script:SetupForm -and -not $script:SetupForm.IsDisposed){$script:SetupProgress.Value=[Math]::Max(0,[Math]::Min(100,$pct));$script:SetupStatus.Text=$message;if($detail){$script:SetupDetail.Text=$detail};$script:SetupForm.Activate();[System.Windows.Forms.Application]::DoEvents()} } catch {}
}
function Focus-SetupUi { try { if($script:SetupForm -and -not $script:SetupForm.IsDisposed){$script:SetupForm.WindowState='Normal';$script:SetupForm.TopMost=$true;$script:SetupForm.Activate();[System.Windows.Forms.Application]::DoEvents();$script:SetupForm.TopMost=$false} } catch {} }
function Close-SetupUi { try { if($script:SetupForm -and -not $script:SetupForm.IsDisposed){$script:SetupForm.Close();$script:SetupForm.Dispose()} } catch {} }
Initialize-SetupUi


function Get-PortOwner([int]$port){
  try { return (Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction Stop | Select-Object -First 1) } catch { return $null }
}
function Get-Proc([int]$pidValue){
  try { return Get-CimInstance Win32_Process -Filter "ProcessId=$pidValue" -ErrorAction Stop } catch { return $null }
}
function Test-PlanificadorProcess($proc){
  if(-not $proc){ return $false }
  $name=[string]$proc.Name
  $cmd=[string]$proc.CommandLine
  return (($name -match '^(powershell|pwsh|cmd)\.exe$') -and ($cmd -match '(?i)servidor_local\.ps1') -and ($cmd.IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0))
}
function Get-Health {
  try { return Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/health" -Method Get -TimeoutSec 1 -ErrorAction Stop } catch { return $null }
}
function Stop-PlanificadorSupervisor {
  try {
    $procs=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
      ($_.Name -match '^(powershell|pwsh)\.exe$') -and ([string]$_.CommandLine -match '(?i)PLANIFICADOR_SUPERVISOR\.ps1') -and ([string]$_.CommandLine).IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0
    }
    foreach($p in @($procs)){
      try { Stop-Process -Id ([int]$p.ProcessId) -Force -ErrorAction SilentlyContinue } catch {}
    }
    if($procs){ Start-Sleep -Milliseconds 500 }
  } catch {}
}
function Stop-PlanificadorListener {
  $health=Get-Health
  if($health -and $health.ok -and $health.serverPid){
    $sameProduct=([string]$health.productId -eq $ProductId)
    $looksLegacy=([string]$health.appVersion -match '^\d+(?:\.\d+){0,2}$')
    if($sameProduct -and (Test-PlanificadorProcess (Get-Proc ([int]$health.serverPid)))){
      Stop-Process -Id ([int]$health.serverPid) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    }
  }
  $owner=Get-PortOwner $Port
  if($owner){
    $proc=Get-Proc ([int]$owner.OwningProcess)
    if(Test-PlanificadorProcess $proc){
      Stop-Process -Id ([int]$owner.OwningProcess) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    } else {
      $pname=if($proc){[string]$proc.Name}else{'desconocido'}
      throw "El puerto local $Port esta ocupado por otra aplicacion ($pname, PID $($owner.OwningProcess)). La instalacion se detuvo para no cerrar procesos ajenos."
    }
  }
  if(Get-PortOwner $Port){ throw "El puerto local $Port sigue ocupado. Cierre la aplicacion que lo usa y vuelva a ejecutar el instalador." }
}
function Close-PlanificadorAppWindows {
  try {
    $needle="127.0.0.1:$Port"
    $procs=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
      ($_.Name -match '^(msedge|chrome|brave)\.exe$') -and
      ([string]$_.CommandLine -match '(?i)--app=.*127\.0\.0\.1:4173')
    }
    foreach($p in @($procs)){
      try { Stop-Process -Id ([int]$p.ProcessId) -Force -ErrorAction SilentlyContinue } catch {}
    }
    if($procs){ Start-Sleep -Milliseconds 450 }
  } catch {}
}
function Request-PlanificadorUpdateClose {
  try {
    $headers=@{Origin="http://127.0.0.1:$Port"}
    return Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/update/request-close" -Method Post -Headers $headers -ContentType 'application/json' -Body '{}' -TimeoutSec 2 -ErrorAction Stop
  } catch { return $null }
}
function Cancel-PlanificadorUpdateClose {
  try {$headers=@{Origin="http://127.0.0.1:$Port"};Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/update/cancel-close" -Method Post -Headers $headers -ContentType 'application/json' -Body '{}' -TimeoutSec 2 -ErrorAction SilentlyContinue|Out-Null}catch{}
}
function Wait-ForPlanificadorClientsToClose {
  if(-not $current){return}
  $health=Get-Health;$count=0;$hasHeartbeat=$false
  if($health){try{$hasHeartbeat=($null -ne $health.PSObject.Properties['activeClients']);if($hasHeartbeat){$count=[int]$health.activeClients}}catch{}}
  if($count -le 0){Close-PlanificadorAppWindows;return}
  Set-SetupUi 8 'Esperando guardado y cierre del Planificador…' 'El instalador permanece abierto y continuará automáticamente al confirmar el cierre seguro.'
  $requested=$null
  if($current -ge [version]'7.4.14'){$requested=Request-PlanificadorUpdateClose}
  if(-not $requested){
    try { Start-Process "http://127.0.0.1:$Port/index.html?pmupdate=close" } catch {}
    $msg=if($current -lt [version]'7.4.14'){"Esta es la primera transición al nuevo sistema de actualización.`n`nSe abrió el Planificador. Guarde/sincronice y cierre sus ventanas. NO cierre este instalador: continuará automáticamente."}else{"No se pudo activar el cierre desde la sesión existente. Se abrió el Planificador para guardar y cerrar. El instalador seguirá esperando automáticamente."}
    [void][System.Windows.Forms.MessageBox]::Show($msg,$Product,[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information)
  }
  $deadline=(Get-Date).AddMinutes(8)
  while((Get-Date) -lt $deadline){
    [System.Windows.Forms.Application]::DoEvents();Start-Sleep -Milliseconds 700;$h=Get-Health;$c=0;if($h -and $h.activeClients -ne $null){$c=[int]$h.activeClients}
    Set-SetupUi 8 'Esperando guardado y cierre del Planificador…' ("Sesiones activas: $c`r`nEl instalador continuará solo cuando el guardado/sincronización termine.")
    if($c -le 0){Close-PlanificadorAppWindows;Focus-SetupUi;Set-SetupUi 10 'Cierre seguro confirmado. Continuando…' 'El Planificador confirmó el guardado y la ventana de aplicación fue cerrada. Preparando respaldo e instalación.';return}
  }
  $again=[System.Windows.Forms.MessageBox]::Show('El Planificador sigue abierto. Pulse Reintentar para continuar esperando o Cancelar para detener la actualización sin modificar la instalación.',$Product,[System.Windows.Forms.MessageBoxButtons]::RetryCancel,[System.Windows.Forms.MessageBoxIcon]::Warning)
  if($again -eq [System.Windows.Forms.DialogResult]::Retry){return Wait-ForPlanificadorClientsToClose}
  Cancel-PlanificadorUpdateClose
  throw 'Actualización cancelada: el Planificador continuaba abierto.'
}
function Get-LocalMachineGuid {
  try { return [string](Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid -ErrorAction Stop).MachineGuid } catch { throw 'No se pudo obtener la identidad del equipo Windows.' }
}
function Ensure-InstallationBinding {
  $entropy=[Text.Encoding]::UTF8.GetBytes($ProductId);$machine=Get-LocalMachineGuid
  if(Test-Path -LiteralPath $BindingFile){
    try {$plain=[System.Security.Cryptography.ProtectedData]::Unprotect([IO.File]::ReadAllBytes($BindingFile),$entropy,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);$obj=([Text.Encoding]::UTF8.GetString($plain))|ConvertFrom-Json;if([string]$obj.productId -eq $ProductId -and [string]$obj.machineGuid -eq $machine){return $obj}} catch {}
  }
  $sha=[System.Security.Cryptography.SHA256]::Create();try{$deviceId=([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($ProductId+'|'+$machine+'|'+[Environment]::UserName)))).Replace('-','').ToLowerInvariant().Substring(0,24)}finally{$sha.Dispose()}
  $obj=[ordered]@{productId=$ProductId;deviceId=$deviceId;machineGuid=$machine;windowsUser=[Environment]::UserName;createdAt=(Get-Date).ToString('o');nonce=[guid]::NewGuid().ToString('N')}
  $bytes=[Text.Encoding]::UTF8.GetBytes(($obj|ConvertTo-Json -Compress));$protected=[System.Security.Cryptography.ProtectedData]::Protect($bytes,$entropy,[System.Security.Cryptography.DataProtectionScope]::CurrentUser)
  [IO.File]::WriteAllBytes($BindingFile,$protected);[IO.File]::WriteAllText($BindingInfoFile,(@{productId=$ProductId;deviceId=$deviceId;boundAt=$obj.createdAt;protection='Windows DPAPI CurrentUser'}|ConvertTo-Json -Depth 4),[Text.UTF8Encoding]::new($false));return [pscustomobject]$obj
}

function Read-LogTail([string]$path,[int]$maxChars=3500){
  if(-not (Test-Path -LiteralPath $path)){ return '' }
  try {
    $t=[IO.File]::ReadAllText($path)
    if($t.Length -gt $maxChars){$t=$t.Substring($t.Length-$maxChars)}
    return $t.Trim()
  } catch { return '' }
}
function Get-StartupDiagnostic([string]$stdoutLog,[string]$stderrLog){
  $parts=@()
  $err=Read-LogTail $stderrLog
  $out=Read-LogTail $stdoutLog
  $boot=Read-LogTail (Join-Path $Data 'server_boot.log')
  if($err){$parts+=('stderr: '+$err)}
  if($out){$parts+=('stdout: '+$out)}
  if($boot){$parts+=('boot: '+$boot)}
  if($parts.Count -eq 0){return 'No se genero salida de diagnostico.'}
  return ($parts -join ' | ')
}
function Get-ByteSha256([byte[]]$bytes){
  $sha=[System.Security.Cryptography.SHA256]::Create()
  try { return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
  finally { $sha.Dispose() }
}
function Get-LocalHttpBytes([string]$relativePath){
  $client=New-Object System.Net.Sockets.TcpClient
  $stream=$null
  try {
    $client.ReceiveTimeout=5000
    $client.SendTimeout=5000
    $client.Connect([System.Net.IPAddress]::Loopback,$Port)
    $stream=$client.GetStream()
    $urlPath='/'+($relativePath.Replace('\','/').TrimStart('/'))
    $request="GET $urlPath HTTP/1.1`r`nHost: 127.0.0.1:$Port`r`nConnection: close`r`nCache-Control: no-cache`r`n`r`n"
    $requestBytes=[Text.Encoding]::ASCII.GetBytes($request)
    $stream.Write($requestBytes,0,$requestBytes.Length)
    $stream.Flush()

    $ms=New-Object IO.MemoryStream
    try {
      $buffer=New-Object byte[] 8192
      while(($read=$stream.Read($buffer,0,$buffer.Length)) -gt 0){ $ms.Write($buffer,0,$read) }
      $raw=$ms.ToArray()
    } finally { $ms.Dispose() }

    if($raw.Length -lt 12){ throw "Respuesta HTTP local incompleta al verificar $relativePath." }
    $headerEnd=-1
    for($i=0;$i -le $raw.Length-4;$i++){
      if($raw[$i] -eq 13 -and $raw[$i+1] -eq 10 -and $raw[$i+2] -eq 13 -and $raw[$i+3] -eq 10){
        $headerEnd=$i
        break
      }
    }
    if($headerEnd -lt 0){ throw "Respuesta HTTP local sin cabeceras validas al verificar $relativePath." }

    $header=[Text.Encoding]::ASCII.GetString($raw,0,$headerEnd)
    $statusLine=($header -split "`r`n")[0]
    if($statusLine -notmatch '^HTTP/1\.[01]\s+(\d{3})\b'){ throw "Estado HTTP local no reconocible al verificar $relativePath." }
    $status=[int]$Matches[1]
    if($status -ne 200){ throw "HTTP local $($status) al verificar $relativePath." }

    $bodyStart=$headerEnd+4
    $bodyLength=$raw.Length-$bodyStart
    if($bodyLength -le 0){ return [byte[]]@() }
    $body=New-Object byte[] $bodyLength
    [Array]::Copy($raw,$bodyStart,$body,0,$bodyLength)
    return [byte[]]$body
  } finally {
    if($stream){ try{$stream.Dispose()}catch{} }
    if($client){ try{$client.Close()}catch{} }
  }
}
function Assert-ServedFile([string]$expectedRoot,[string]$relativePath){
  $local=Join-Path $expectedRoot $relativePath
  if(-not (Test-Path -LiteralPath $local -PathType Leaf)){ throw "No existe el archivo local a verificar: $relativePath" }
  $expected=(Get-FileHash -LiteralPath $local -Algorithm SHA256).Hash.ToLowerInvariant()
  $served=Get-LocalHttpBytes $relativePath
  if($null -eq $served -or $served.Length -le 0){ throw "El servidor devolvio vacio al verificar $relativePath." }
  $actual=Get-ByteSha256 ([byte[]]$served)
  if($actual -ne $expected){ throw "El archivo servido no coincide con el instalado: $relativePath (esperado $expected, recibido $actual)." }
}
function Assert-Runtime([string]$expectedRoot,$serverProc,[string]$stdoutLog,[string]$stderrLog){
  $health=$null
  for($i=0;$i -lt 240;$i++){
    Start-Sleep -Milliseconds 250
    if($serverProc){
      try{$serverProc.Refresh()}catch{}
      if($serverProc.HasExited){
        $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
        throw "El proceso del servidor local termino antes de responder (codigo $($serverProc.ExitCode)). $diag"
      }
    }
    $health=Get-Health
    if($health -and $health.ok){ break }
  }
  if(-not $health -or -not $health.ok){
    $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
    throw "El servidor local nuevo no respondio despues de la espera de arranque. $diag"
  }
  if([string]$health.productId -ne $ProductId){ throw "El puerto $Port responde con otro producto." }
  if([string]$health.appVersion -ne $ExpectedVersion){ throw "La version servida es $($health.appVersion), no V$($ExpectedVersion)." }
  try{$servedRoot=[IO.Path]::GetFullPath([string]$health.appRoot)}catch{throw 'El servidor no informo una ruta de aplicacion valida.'}
  if(-not $servedRoot.Equals([IO.Path]::GetFullPath($expectedRoot),[StringComparison]::OrdinalIgnoreCase)){ throw 'El servidor activo no corresponde a la carpeta App recien instalada.' }
  foreach($file in @('index.html','app.js','styles.css','manifest.webmanifest','sw.js')){ Assert-ServedFile $expectedRoot $file }
  return $health
}
function Write-Step([int]$pct,[string]$message){
  Write-Host ('['+$pct+'%] '+$message)
  try { Write-Progress -Activity ('Planificador Multifamiliar V'+$ExpectedVersion) -Status $message -PercentComplete $pct } catch {}
  Set-SetupUi $pct $message
}
function Trim-BackupSet([string]$path,[string]$filter,[int]$keep=10){
  if(-not (Test-Path -LiteralPath $path)){return}
  try {
    $items=@(Get-ChildItem -LiteralPath $path -Filter $filter -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if($items.Count -gt $keep){ $items | Select-Object -Skip $keep | Remove-Item -Force -ErrorAction SilentlyContinue }
  } catch {}
}
function Restart-RestoredRuntime {
  try {
    $sup=Join-Path $App 'PLANIFICADOR_SUPERVISOR.ps1'
    $ps=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    if((Test-Path -LiteralPath $sup) -and (Test-Path -LiteralPath $ps)){
      $args='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$sup+'"'
      Start-Process -FilePath $ps -ArgumentList $args -WindowStyle Hidden -ErrorAction SilentlyContinue
    }
  } catch {}
}

$current=$null
$versionFile=Join-Path $App 'VERSION.txt'
if(Test-Path -LiteralPath $versionFile){
  $txt=Get-Content -LiteralPath $versionFile -Raw
  if($txt -match 'V(\d+\.\d+(?:\.\d+)?)'){ try{$current=[version]$Matches[1]}catch{} }
}
if($current -and $current -gt $NewVersion){
  [System.Windows.Forms.MessageBox]::Show("Hay una version mas nueva instalada ($current).`n`nEste instalador es V$NewVersion y no puede hacer downgrade.",$Product,[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Warning)|Out-Null
  exit 3
}
$mode=if(-not $current){'Instalacion'}elseif($current -eq $NewVersion){'Reparacion'}else{'Actualizacion'}

# Extraer y verificar el payload antes de tocar App.
Write-Step 5 'Leyendo y verificando el paquete de actualización…'
$lines=[IO.File]::ReadAllLines($Self)
$marker='__PM_PAYLOAD__'
$idx=[Array]::IndexOf($lines,$marker)
if($idx -lt 0){ throw 'El instalador esta incompleto: no contiene payload.' }
$b64=(-join $lines[($idx+1)..($lines.Length-1)]).Trim()
$temp=Join-Path $env:TEMP ('PM_Install_'+[guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $temp -Force | Out-Null
$zip=Join-Path $temp 'payload.zip'
[IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($b64))
$expectedPayloadSha='841b3cc157da321e42577403f40011f9301a08b2280c9cebed5c0f3b807af501'
$actualPayloadSha=(Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash.ToLowerInvariant()
if($actualPayloadSha -ne $expectedPayloadSha){
  $externalPayload=Join-Path (Split-Path -Parent $Self) 'Planificador_Multifamiliar_PAYLOAD_V7_4_21.zip'
  $externalSha=''
  if(Test-Path -LiteralPath $externalPayload -PathType Leaf){try{$externalSha=(Get-FileHash -LiteralPath $externalPayload -Algorithm SHA256).Hash.ToLowerInvariant()}catch{}}
  if($externalSha -eq $expectedPayloadSha){Copy-Item -LiteralPath $externalPayload -Destination $zip -Force;$actualPayloadSha=$externalSha}
  else { throw ("El paquete embebido esta danado. No se modifico la instalacion.`nSHA esperado: $expectedPayloadSha`nSHA obtenido: $actualPayloadSha`nPayload externo: $externalSha`nArchivo temporal: $zip") }
}

$extract=Join-Path $temp 'payload'
Expand-Archive -LiteralPath $zip -DestinationPath $extract -Force
Write-Step 15 'Paquete extraído. Verificando integridad de archivos…'

foreach($required in @('app.js','index.html','styles.css','servidor_local.ps1','VERSION.txt','manifest.webmanifest','sw.js','cache_reset.html','INSTALLATION_INTEGRITY.json')){
  if(-not (Test-Path -LiteralPath (Join-Path $extract $required))){ throw "Paquete incompleto: $required" }
}
$integrity=(Get-Content -LiteralPath (Join-Path $extract 'INSTALLATION_INTEGRITY.json') -Raw | ConvertFrom-Json)
if([string]$integrity.productId -ne $ProductId -or [string]$integrity.version -ne $ExpectedVersion){ throw 'Manifiesto de integridad de otra version o producto.' }
foreach($prop in $integrity.files.PSObject.Properties){
  $p=Join-Path $extract ([string]$prop.Name)
  if(-not (Test-Path -LiteralPath $p -PathType Leaf)){ throw "Archivo de integridad faltante: $($prop.Name)" }
  $actual=(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant()
  if($actual -ne ([string]$prop.Value).ToLowerInvariant()){ throw "Integridad incorrecta: $($prop.Name)" }
}
$versionText=Get-Content -LiteralPath (Join-Path $extract 'VERSION.txt') -Raw
if($versionText -notmatch ('Planificador Multifamiliar V'+[regex]::Escape($ExpectedVersion))){ throw "VERSION.txt no corresponde a V$($ExpectedVersion)." }

if($env:PM_VALIDATE_ONLY -eq '1'){
  Write-Output ('VALIDATION_OK V'+$ExpectedVersion+' files='+@($integrity.files.PSObject.Properties).Count)
  exit 0
}

# Resolver supervisor/servidor previos antes de reemplazar App.
Write-Step 24 'Comprobando que el Planificador esté guardado y cerrado…'
Wait-ForPlanificadorClientsToClose
Write-Step 30 'Preparando actualización y deteniendo solo los procesos del Planificador…'
Stop-PlanificadorSupervisor
Stop-PlanificadorListener

$stage=Join-Path $Root ('App_staging_'+[guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $stage -Force | Out-Null
Copy-Item -Path (Join-Path $extract '*') -Destination $stage -Recurse -Force

# Respaldos. Data y Backups nunca se reinicializan.
Write-Step 42 'Creando respaldo recuperable de programa y datos…'
$stamp=(Get-Date -Format 'yyyyMMdd_HHmmss_fff')
if(Test-Path -LiteralPath $App){
  $appBackup=Join-Path $AppBackups "App_pre_${stamp}.zip"
  Compress-Archive -Path (Join-Path $App '*') -DestinationPath $appBackup -CompressionLevel Optimal -Force
}
$state=Join-Path $Data 'project_state.json'
if(Test-Path -LiteralPath $state){ Copy-Item -LiteralPath $state -Destination (Join-Path $DataBackups "project_state_pre_${stamp}.json") -Force }
$syncCfg=Join-Path $Data 'sync_config.json'
if(Test-Path -LiteralPath $syncCfg){ Copy-Item -LiteralPath $syncCfg -Destination (Join-Path $DataBackups "sync_config_pre_${stamp}.json") -Force }
if(Get-ChildItem -LiteralPath $Data -Force | Select-Object -First 1){ Compress-Archive -Path (Join-Path $Data '*') -DestinationPath (Join-Path $DataBackups "Data_pre_${stamp}.zip") -CompressionLevel Optimal -Force }

$previousApp=Join-Path $AppBackups "App_pre_${stamp}"
$rootFull=[IO.Path]::GetFullPath($Root).TrimEnd('\')+'\'
foreach($candidate in @($App,$stage,$previousApp)){
  if(-not [IO.Path]::GetFullPath($candidate).StartsWith($rootFull,[StringComparison]::OrdinalIgnoreCase)){ throw 'Ruta fuera de la instalacion.' }
}
$movedPrevious=$false
$runtimeStarted=$false
$serverProc=$null
$stdoutLog=Join-Path $Data 'server_startup_stdout.log'
$stderrLog=Join-Path $Data 'server_startup_stderr.log'
Remove-Item -LiteralPath $stdoutLog,$stderrLog -Force -ErrorAction SilentlyContinue
Write-Step 58 'Instalando la nueva versión…'
try{
  if(Test-Path -LiteralPath $App){ Move-Item -LiteralPath $App -Destination $previousApp; $movedPrevious=$true }
  Move-Item -LiteralPath $stage -Destination $App
  Write-Step 64 'Vinculando esta instalación al usuario y equipo Windows…'
  $binding=Ensure-InstallationBinding

  # Iniciar y observar el proceso real del servidor.
  $server=Join-Path $App 'servidor_local.ps1'
  $psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
  $argLine='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$server+'" -NoBrowser'
  $serverProc=Start-Process -FilePath $psExe -ArgumentList $argLine -WindowStyle Hidden -PassThru -RedirectStandardOutput $stdoutLog -RedirectStandardError $stderrLog
  $runtimeStarted=$true
  Write-Step 72 'Iniciando y verificando el runtime local (hasta 60 s)…'
  $verified=Assert-Runtime $App $serverProc $stdoutLog $stderrLog
  Write-Step 84 'Runtime verificado. Finalizando configuración…'
}catch{
  $reason=$_.Exception.Message
  if($runtimeStarted){
    $h=Get-Health
    if($h -and $h.serverPid){ Stop-Process -Id ([int]$h.serverPid) -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 300 }
    elseif($serverProc -and -not $serverProc.HasExited){ Stop-Process -Id $serverProc.Id -Force -ErrorAction SilentlyContinue }
  }
  if(Test-Path -LiteralPath $App){ Remove-Item -LiteralPath $App -Recurse -Force -ErrorAction SilentlyContinue }
  if($movedPrevious -and (Test-Path -LiteralPath $previousApp)){ Move-Item -LiteralPath $previousApp -Destination $App -Force; Restart-RestoredRuntime }
  throw "La instalacion fue revertida porque la verificacion final fallo: $reason"
}

# Conservar instalador para publicación automática.
$installerName='Instalador_Actualizador_Planificador_Multifamiliar_V'+$ExpectedVersion.Replace('.','_')+'.cmd'
$cachedInstaller=Join-Path $LocalUpdates $installerName
try { if([IO.Path]::GetFullPath($Self) -ne [IO.Path]::GetFullPath($cachedInstaller)){ Copy-Item -LiteralPath $Self -Destination $cachedInstaller -Force } } catch { Write-Warning ('No se pudo conservar copia local del instalador: '+$_.Exception.Message) }

# La carpeta App anterior ya no es necesaria para rollback después de validar la nueva versión.
if($movedPrevious -and (Test-Path -LiteralPath $previousApp)){ Remove-Item -LiteralPath $previousApp -Recurse -Force -ErrorAction SilentlyContinue }
Trim-BackupSet $AppBackups 'App_pre_*.zip' 10
Trim-BackupSet $DataBackups 'Data_pre_*.zip' 10
Trim-BackupSet $DataBackups 'project_state_pre_*.json' 10
Trim-BackupSet $DataBackups 'sync_config_pre_*.json' 10

$postWarnings=New-Object System.Collections.Generic.List[string]
$installInfo=@{
  product=$Product; productId=$ProductId; version=$NewVersion.ToString(); installedAt=(Get-Date).ToString('o');
  appPath=$App; dataPath=$Data; origin="http://127.0.0.1:$Port"; updateMode=$mode; dataSchema='7.33'; runtimeVerified=$true
}|ConvertTo-Json -Depth 5
try { [IO.File]::WriteAllText((Join-Path $Root 'installation.json'),$installInfo,[Text.UTF8Encoding]::new($false)) } catch { $postWarnings.Add('installation.json: '+$_.Exception.Message) }

# Registrar instalación exitosa para el Centro de Actualizaciones.
try {
  $historyFile=Join-Path $Data 'update_history.json';$history=@()
  if(Test-Path -LiteralPath $historyFile){ try{$history=@(Get-Content -LiteralPath $historyFile -Raw|ConvertFrom-Json)}catch{$history=@()} }
  $selfSha=(Get-FileHash -LiteralPath $Self -Algorithm SHA256).Hash.ToLowerInvariant();$fromText=if($current){' · desde V'+$current.ToString()}else{''}
  $entry=[ordered]@{at=(Get-Date).ToString('o');event='installed';version=$NewVersion.ToString();detail=('Instalación verificada · '+$mode+$fromText);sha256=$selfSha}
  $history=@($entry)+@($history);if($history.Count -gt 100){$history=@($history|Select-Object -First 100)}
  [IO.File]::WriteAllText($historyFile,($history|ConvertTo-Json -Depth 8),[Text.UTF8Encoding]::new($false))
} catch { $postWarnings.Add('Historial de actualización: '+$_.Exception.Message) }

Write-Step 90 'Creando accesos directos y registro de usuario…'
$psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
$launcher=Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1';$supervisor=Join-Path $App 'PLANIFICADOR_SUPERVISOR.ps1';$icon=Join-Path $App 'Planificador.ico';$un=Join-Path $App 'DESINSTALAR_PLANIFICADOR.bat'
try {
  $ws=New-Object -ComObject WScript.Shell
  $desktop=[Environment]::GetFolderPath('Desktop');$lnk=$ws.CreateShortcut((Join-Path $desktop 'Planificador Multifamiliar.lnk'))
  $lnk.TargetPath=$psExe;$lnk.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"');$lnk.WorkingDirectory=$App;$lnk.Description='Planificador Multifamiliar V7';if(Test-Path -LiteralPath $icon){$lnk.IconLocation=$icon};$lnk.WindowStyle=7;$lnk.Save()
  $programs=[Environment]::GetFolderPath('Programs');$menu=Join-Path $programs 'Planificador Multifamiliar';New-Item -ItemType Directory -Path $menu -Force|Out-Null
  $lnk2=$ws.CreateShortcut((Join-Path $menu 'Planificador Multifamiliar.lnk'));$lnk2.TargetPath=$psExe;$lnk2.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"');$lnk2.WorkingDirectory=$App;$lnk2.Description='Planificador Multifamiliar V7';if(Test-Path -LiteralPath $icon){$lnk2.IconLocation=$icon};$lnk2.WindowStyle=7;$lnk2.Save()
  $startup=[Environment]::GetFolderPath('Startup');Remove-Item (Join-Path $startup 'Planificador Multifamiliar - Servidor local.lnk') -Force -ErrorAction SilentlyContinue
  $auto=$ws.CreateShortcut((Join-Path $startup 'Planificador Multifamiliar - Servicio local.lnk'));$auto.TargetPath=$psExe;$auto.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"');$auto.WorkingDirectory=$App;$auto.Description='Servicio local supervisado del Planificador Multifamiliar';if(Test-Path -LiteralPath $icon){$auto.IconLocation=$icon};$auto.WindowStyle=7;$auto.Save()
  $lnk3=$ws.CreateShortcut((Join-Path $menu 'Desinstalar Planificador.lnk'));$lnk3.TargetPath=$un;$lnk3.WorkingDirectory=$App;if(Test-Path -LiteralPath $icon){$lnk3.IconLocation=$icon};$lnk3.Save()
} catch { $postWarnings.Add('Accesos directos: '+$_.Exception.Message) }

# Supervisor: el servidor verificado ya está activo; el supervisor mantiene recuperación posterior.
try { $supArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"';Start-Process -FilePath $psExe -ArgumentList $supArgs -WindowStyle Hidden } catch { $postWarnings.Add('Supervisor: '+$_.Exception.Message) }
try {
  $reg='HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\PlanificadorMultifamiliar';New-Item $reg -Force|Out-Null
  Set-ItemProperty $reg DisplayName $Product;Set-ItemProperty $reg DisplayVersion $NewVersion.ToString();Set-ItemProperty $reg Publisher 'Planificador Multifamiliar';Set-ItemProperty $reg InstallLocation $Root;Set-ItemProperty $reg UninstallString ('"'+$un+'"');Set-ItemProperty $reg NoModify 1 -Type DWord;Set-ItemProperty $reg NoRepair 1 -Type DWord
} catch { $postWarnings.Add('Registro de Windows: '+$_.Exception.Message) }

$tempFull=[IO.Path]::GetFullPath($temp);$tempRoot=[IO.Path]::GetFullPath($env:TEMP).TrimEnd('\')+'\'
if($tempFull.StartsWith($tempRoot,[StringComparison]::OrdinalIgnoreCase) -and (Split-Path $tempFull -Leaf).StartsWith('PM_Install_')){ Remove-Item -LiteralPath $tempFull -Recurse -Force -ErrorAction SilentlyContinue }

Write-Step 100 'Actualización completada.'
try { Write-Progress -Activity ('Planificador Multifamiliar V'+$ExpectedVersion) -Completed } catch {}
$message="V$NewVersion instalada y verificada.`n`n- Permisos efectivos sincronizados y revalidados en Supabase.`n- Sesiones de colaboradores refrescan permisos desde nube.`n- Campos textuales operativos se escriben en MAYÚSCULAS.`n- La ventana PWA se cierra por completo durante la actualización.`n- Procesos auxiliares permanecen ocultos; solo se muestra esta ventana.`n- Conserva EDT, Plan Maestro, Lookahead, Campo, Control y Reportes de V7.4.19.`n- Data y Backups conservados."
if($postWarnings.Count -gt 0){$message+="`n`nAvisos no fatales:`n- "+($postWarnings -join "`n- ")}
Set-SetupUi 100 'Actualización completada.' $message
Focus-SetupUi
Start-Sleep -Milliseconds 1600
Close-SetupUi

# Abrir siempre por el launcher instalado; este usa ventana tipo aplicación y navegador normal solo como fallback.
$launchArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+(Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1')+'"'
Start-Process -FilePath $psExe -ArgumentList $launchArgs -WindowStyle Hidden
__PM_END_SCRIPT__
