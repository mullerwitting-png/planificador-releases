  if([string]$j.productId -ne $ProductId -or [string]$j.version -ne $ExpectedVersion -or [string]$j.algorithm -ne 'SHA256'){throw 'Manifest de integridad de otro producto o versión.'}
  $count=0;foreach($prop in $j.files.PSObject.Properties){$rel=[string]$prop.Name;$want=([string]$prop.Value).ToUpperInvariant();$file=Join-Path $dir ($rel -replace '/','\');if(-not(Test-Path -LiteralPath $file -PathType Leaf)){throw "Archivo faltante: $rel"};$got=Sha $file;if($got -ne $want){throw "Hash incorrecto: $rel"};$count++}
  if($j.fileCount -and [int]$j.fileCount -ne $count){throw "Conteo de integridad incorrecto: $count de $($j.fileCount)"}
  return $count
}
function Get-AppWindows {
  try{return @(Get-CimInstance Win32_Process -ErrorAction SilentlyContinue|Where-Object{($_.Name -match '^(msedge|chrome|brave)\.exe$') -and ([string]$_.CommandLine -match '(?i)127\.0\.0\.1:4173') -and ([string]$_.CommandLine -match '(?i)--app=|launcher=')})}catch{return @()}
}
function Wait-ForAppWindowsToClose {
  while($true){$wins=Get-AppWindows;if(-not $wins.Count){return};$r=[Windows.Forms.MessageBox]::Show("Hay $($wins.Count) ventana(s) del Planificador abiertas.`n`nGuarde cualquier edición y cierre completamente esas ventanas. Después pulse Reintentar.`n`nCancelar no modifica la instalación.",'Planificador abierto',[Windows.Forms.MessageBoxButtons]::RetryCancel,[Windows.Forms.MessageBoxIcon]::Warning);if($r -eq [Windows.Forms.DialogResult]::Cancel){throw 'Actualización cancelada por el usuario. No se modificó la instalación.'}}
