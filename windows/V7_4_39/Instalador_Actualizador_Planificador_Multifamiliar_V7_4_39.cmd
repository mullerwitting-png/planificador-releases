  $j=Get-Content $mf -Raw | ConvertFrom-Json;if([string]$j.version -ne $ExpectedVersion){throw "Manifest de integridad incorrecto: $($j.version)"}
  $count=0
  foreach($prop in $j.files.PSObject.Properties){$rel=$prop.Name;$want=[string]$prop.Value;$file=Join-Path $dir ($rel -replace '/','\\');if(-not(Test-Path -LiteralPath $file -PathType Leaf)){throw "Archivo faltante: $rel"};$got=Sha $file;if($got -ne $want.ToLowerInvariant()){throw "Hash incorrecto: $rel"};$count++}
  return $count
}
