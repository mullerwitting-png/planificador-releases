copy,$save,$open,$close)); $f.Controls.Add($box); $f.Controls.Add($panel); [void]$f.ShowDialog() } catch { try{Start-Process notepad.exe -ArgumentList ('\"'+$path+'\"')}catch{} }; exit 1 }"
