function Get-PortOwner([int]$port){
  try { return (Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction Stop | Select-Object -First 1) } catch { return $null }
}
function Get-Proc([int]$pidValue){
  try { return Get-CimInstance Win32_Process -Filter "ProcessId=$pidValue" -ErrorAction Stop } catch { return $null }
}
function Test-PlanificadorProcess($proc){
  if(-not $proc){ return $false }
  $name=[string]$proc.Name
  $cmd=[string]$proc.CommandLine
  return (($name -match '^(powershell|pwsh|cmd)\.exe$') -and ($cmd -match '(?i)servidor_local\.ps1') -and ($cmd.IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0))
}
function Get-Health {
  try { return Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/health" -Method Get -TimeoutSec 1 -ErrorAction Stop } catch { return $null }
}
function Stop-PlanificadorSupervisor {
  try {
    $procs=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
      ($_.Name -match '^(powershell|pwsh)\.exe$') -and ([string]$_.CommandLine -match '(?i)PLANIFICADOR_SUPERVISOR\.ps1') -and ([string]$_.CommandLine).IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0
    }
    foreach($p in @($procs)){
      try { Stop-Process -Id ([int]$p.ProcessId) -Force -ErrorAction SilentlyContinue } catch {}
    }
    if($procs){ Start-Sleep -Milliseconds 500 }
  } catch {}
}
function Stop-PlanificadorListener {
  $health=Get-Health
  if($health -and $health.ok -and $health.serverPid){
    $sameProduct=([string]$health.productId -eq $ProductId)
    $looksLegacy=([string]$health.appVersion -match '^\d+(?:\.\d+){0,2}$')
    if($sameProduct -and (Test-PlanificadorProcess (Get-Proc ([int]$health.serverPid)))){
      Stop-Process -Id ([int]$health.serverPid) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    }
  }
  $owner=Get-PortOwner $Port
  if($owner){
    $proc=Get-Proc ([int]$owner.OwningProcess)
    if(Test-PlanificadorProcess $proc){
      Stop-Process -Id ([int]$owner.OwningProcess) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    } else {
      $pname=if($proc){[string]$proc.Name}else{'desconocido'}
      throw "El puerto local $Port esta ocupado por otra aplicacion ($pname, PID $($owner.OwningProcess)). La instalacion se detuvo para no cerrar procesos ajenos."
    }
  }
  if(Get-PortOwner $Port){ throw "El puerto local $Port sigue ocupado. Cierre la aplicacion que lo usa y vuelva a ejecutar el instalador." }
}
function Close-PlanificadorAppWindows {
  try {
    $needle="127.0.0.1:$Port"
    $procs=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
      ($_.Name -match '^(msedge|chrome|brave)\.exe$') -and
      ([string]$_.CommandLine -match '(?i)--app=.*127\.0\.0\.1:4173')
    }
    foreach($p in @($procs)){
      try { Stop-Process -Id ([int]$p.ProcessId) -Force -ErrorAction SilentlyContinue } catch {}
    }
    if($procs){ Start-Sleep -Milliseconds 450 }
  } catch {}
}
function Request-PlanificadorUpdateClose {
  try {
    $headers=@{Origin="http://127.0.0.1:$Port"}
    return Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/update/request-close" -Method Post -Headers $headers -ContentType 'application/json' -Body '{}' -TimeoutSec 2 -ErrorAction Stop
  } catch { return $null }
}
function Cancel-PlanificadorUpdateClose {
  try {$headers=@{Origin="http://127.0.0.1:$Port"};Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/update/cancel-close" -Method Post -Headers $headers -ContentType 'application/json' -Body '{}' -TimeoutSec 2 -ErrorAction SilentlyContinue|Out-Null}catch{}
}
function Wait-ForPlanificadorClientsToClose {
  # V7.4.28: guardar/sincronizar/cerrar PWA ANTES de detener el servidor.
  # El flujo normal permanece dentro de la ventana profesional; no abre navegador ni MessageBox auxiliares.
  if(-not $current){Close-PlanificadorAppWindows;return}
  $health=Get-Health;$count=0
  if($health){try{if($null -ne $health.PSObject.Properties['activeClients']){$count=[int]$health.activeClients}}catch{}}
  if($count -le 0){Close-PlanificadorAppWindows;return}
  Set-SetupUi 8 'Guardando y cerrando el Planificador...' 'Se está guardando el estado local, sincronizando la nube y cerrando la ventana de aplicación antes de detener el servicio local.'
  $requested=$null
  if($current -ge [version]'7.4.14'){$requested=Request-PlanificadorUpdateClose}
  $deadline=(Get-Date).AddSeconds(12)
  while((Get-Date) -lt $deadline){
    [System.Windows.Forms.Application]::DoEvents();Start-Sleep -Milliseconds 500
    $h=Get-Health;$c=0
    if($h -and $h.activeClients -ne $null){try{$c=[int]$h.activeClients}catch{$c=0}}
    Set-SetupUi 8 'Guardando y cerrando el Planificador...' ("Sesiones activas: $c`r`nLa actualización continuará automáticamente al completar el cierre seguro.")
    if($c -le 0){break}
  }
  # Si el navegador no obedeció el cierre web, cerrar únicamente ventanas PWA del Planificador.
  Close-PlanificadorAppWindows
  Focus-SetupUi
  Set-SetupUi 10 'Ventana del Planificador cerrada.' 'Los datos locales quedaron protegidos. Preparando respaldo y actualización del servicio.'
  [System.Windows.Forms.Application]::DoEvents();Start-Sleep -Milliseconds 500
  return
}
function Get-LocalMachineGuid {
  try { return [string](Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid -ErrorAction Stop).MachineGuid } catch { throw 'No se pudo obtener la identidad del equipo Windows.' }
}
function Ensure-InstallationBinding {
  $entropy=[Text.Encoding]::UTF8.GetBytes($ProductId);$machine=Get-LocalMachineGuid
  if(Test-Path -LiteralPath $BindingFile){
    try {$plain=[System.Security.Cryptography.ProtectedData]::Unprotect([IO.File]::ReadAllBytes($BindingFile),$entropy,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);$obj=([Text.Encoding]::UTF8.GetString($plain))|ConvertFrom-Json;if([string]$obj.productId -eq $ProductId -and [string]$obj.machineGuid -eq $machine){return $obj}} catch {}
  }
  $sha=[System.Security.Cryptography.SHA256]::Create();try{$deviceId=([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($ProductId+'|'+$machine+'|'+[Environment]::UserName)))).Replace('-','').ToLowerInvariant().Substring(0,24)}finally{$sha.Dispose()}
  $obj=[ordered]@{productId=$ProductId;deviceId=$deviceId;machineGuid=$machine;windowsUser=[Environment]::UserName;createdAt=(Get-Date).ToString('o');nonce=[guid]::NewGuid().ToString('N')}
  $bytes=[Text.Encoding]::UTF8.GetBytes(($obj|ConvertTo-Json -Compress));$protected=[System.Security.Cryptography.ProtectedData]::Protect($bytes,$entropy,[System.Security.Cryptography.DataProtectionScope]::CurrentUser)
  [IO.File]::WriteAllBytes($BindingFile,$protected);[IO.File]::WriteAllText($BindingInfoFile,(@{productId=$ProductId;deviceId=$deviceId;boundAt=$obj.createdAt;protection='Windows DPAPI CurrentUser'}|ConvertTo-Json -Depth 4),[Text.UTF8Encoding]::new($false));return [pscustomobject]$obj
}

function Read-LogTail([string]$path,[int]$maxChars=3500){
  if(-not (Test-Path -LiteralPath $path)){ return '' }
  try {
    $t=[IO.File]::ReadAllText($path)
    if($t.Length -gt $maxChars){$t=$t.Substring($t.Length-$maxChars)}
    return $t.Trim()
  } catch { return '' }
}
function Get-StartupDiagnostic([string]$stdoutLog,[string]$stderrLog){
  $parts=@()
  $err=Read-LogTail $stderrLog
  $out=Read-LogTail $stdoutLog
  $boot=Read-LogTail (Join-Path $Data 'server_boot.log')
  if($err){$parts+=('stderr: '+$err)}
  if($out){$parts+=('stdout: '+$out)}
  if($boot){$parts+=('boot: '+$boot)}
  if($parts.Count -eq 0){return 'No se genero salida de diagnostico.'}
  return ($parts -join ' | ')
}
function Get-ByteSha256([byte[]]$bytes){
  $sha=[System.Security.Cryptography.SHA256]::Create()
  try { return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
  finally { $sha.Dispose() }
}
function Get-LocalHttpBytes([string]$relativePath){
  $client=New-Object System.Net.Sockets.TcpClient
  $stream=$null
  try {
    $client.ReceiveTimeout=5000
    $client.SendTimeout=5000
    $client.Connect([System.Net.IPAddress]::Loopback,$Port)
    $stream=$client.GetStream()
    $urlPath='/'+($relativePath.Replace('\','/').TrimStart('/'))
    $request="GET $urlPath HTTP/1.1`r`nHost: 127.0.0.1:$Port`r`nConnection: close`r`nCache-Control: no-cache`r`n`r`n"
    $requestBytes=[Text.Encoding]::ASCII.GetBytes($request)
    $stream.Write($requestBytes,0,$requestBytes.Length)
    $stream.Flush()

    $ms=New-Object IO.MemoryStream
    try {
      $buffer=New-Object byte[] 8192
      while(($read=$stream.Read($buffer,0,$buffer.Length)) -gt 0){ $ms.Write($buffer,0,$read) }
      $raw=$ms.ToArray()
    } finally { $ms.Dispose() }

    if($raw.Length -lt 12){ throw "Respuesta HTTP local incompleta al verificar $relativePath." }
    $headerEnd=-1
    for($i=0;$i -le $raw.Length-4;$i++){
      if($raw[$i] -eq 13 -and $raw[$i+1] -eq 10 -and $raw[$i+2] -eq 13 -and $raw[$i+3] -eq 10){
        $headerEnd=$i
        break
      }
    }
    if($headerEnd -lt 0){ throw "Respuesta HTTP local sin cabeceras validas al verificar $relativePath." }

    $header=[Text.Encoding]::ASCII.GetString($raw,0,$headerEnd)
    $statusLine=($header -split "`r`n")[0]
    if($statusLine -notmatch '^HTTP/1\.[01]\s+(\d{3})\b'){ throw "Estado HTTP local no reconocible al verificar $relativePath." }
    $status=[int]$Matches[1]
    if($status -ne 200){ throw "HTTP local $($status) al verificar $relativePath." }

    $bodyStart=$headerEnd+4
    $bodyLength=$raw.Length-$bodyStart
    if($bodyLength -le 0){ return [byte[]]@() }
    $body=New-Object byte[] $bodyLength
    [Array]::Copy($raw,$bodyStart,$body,0,$bodyLength)
    return [byte[]]$body
  } finally {
    if($stream){ try{$stream.Dispose()}catch{} }
    if($client){ try{$client.Close()}catch{} }
  }
}
function Assert-ServedFile([string]$expectedRoot,[string]$relativePath){
  $local=Join-Path $expectedRoot $relativePath
  if(-not (Test-Path -LiteralPath $local -PathType Leaf)){ throw "No existe el archivo local a verificar: $relativePath" }
  $expected=(Get-FileHash -LiteralPath $local -Algorithm SHA256).Hash.ToLowerInvariant()
  $served=Get-LocalHttpBytes $relativePath
  if($null -eq $served -or $served.Length -le 0){ throw "El servidor devolvio vacio al verificar $relativePath." }
  $actual=Get-ByteSha256 ([byte[]]$served)
  if($actual -ne $expected){ throw "El archivo servido no coincide con el instalado: $relativePath (esperado $expected, recibido $actual)." }
}
function Assert-Runtime([string]$expectedRoot,$serverProc,[string]$stdoutLog,[string]$stderrLog){
  $health=$null
  for($i=0;$i -lt 240;$i++){
    Start-Sleep -Milliseconds 250
    if($serverProc){
      try{$serverProc.Refresh()}catch{}
      if($serverProc.HasExited){
        $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
        throw "El proceso del servidor local termino antes de responder (codigo $($serverProc.ExitCode)). $diag"
      }
    }
    $health=Get-Health
    if($health -and $health.ok){ break }
  }
  if(-not $health -or -not $health.ok){
    $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
    throw "El servidor local nuevo no respondio despues de la espera de arranque. $diag"
  }
  if([string]$health.productId -ne $ProductId){ throw "El puerto $Port responde con otro producto." }
  if([string]$health.appVersion -ne $ExpectedVersion){ throw "La version servida es $($health.appVersion), no V$($ExpectedVersion)." }
  try{$servedRoot=[IO.Path]::GetFullPath([string]$health.appRoot)}catch{throw 'El servidor no informo una ruta de aplicacion valida.'}
  if(-not $servedRoot.Equals([IO.Path]::GetFullPath($expectedRoot),[StringComparison]::OrdinalIgnoreCase)){ throw 'El servidor activo no corresponde a la carpeta App recien instalada.' }
  foreach($file in @('index.html','app.js','styles.css','manifest.webmanifest','sw.js')){ Assert-ServedFile $expectedRoot $file }
  return $health
}
function Write-Step([int]$pct,[string]$message){
  Write-Host ('['+$pct+'%] '+$message)
  try { Write-Progress -Activity ('Planificador Multifamiliar V'+$ExpectedVersion) -Status $message -PercentComplete $pct } catch {}
  Set-SetupUi $pct $message
}
function Trim-BackupSet([string]$path,[string]$filter,[int]$keep=10){
  if(-not (Test-Path -LiteralPath $path)){return}
  try {
    $items=@(Get-ChildItem -LiteralPath $path -Filter $filter -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending)
    if($items.Count -gt $keep){ $items | Select-Object -Skip $keep | Remove-Item -Force -ErrorAction SilentlyContinue }
  } catch {}
}
function Restart-RestoredRuntime {
  try {
    $sup=Join-Path $App 'PLANIFICADOR_SUPERVISOR.ps1'
    $ps=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    if((Test-Path -LiteralPath $sup) -and (Test-Path -LiteralPath $ps)){
      $args='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$sup+'"'
      Start-Process -FilePath $ps -ArgumentList $args -WindowStyle Hidden -ErrorAction SilentlyContinue
    }
  } catch {}
}

$current=$null
$versionFile=Join-Path $App 'VERSION.txt'
if(Test-Path -LiteralPath $versionFile){
  $txt=Get-Content -LiteralPath $versionFile -Raw
  if($txt -match 'V(\d+\.\d+(?:\.\d+)?)'){ try{$current=[version]$Matches[1]}catch{} }
