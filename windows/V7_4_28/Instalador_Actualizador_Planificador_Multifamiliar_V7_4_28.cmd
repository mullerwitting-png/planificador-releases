    $ver=New-Object System.Windows.Forms.Label;$ver.Left=30;$ver.Top=66;$ver.Width=600;$ver.Height=24;$ver.Font=New-Object Drawing.Font('Segoe UI',10);$ver.Text="Actualizando a V$ExpectedVersion ? sus datos y respaldos se conservan"
    $status=New-Object System.Windows.Forms.Label;$status.Left=30;$status.Top=118;$status.Width=600;$status.Height=42;$status.Font=New-Object Drawing.Font('Segoe UI',10,[Drawing.FontStyle]::Bold);$status.Text='Preparando actualizaci?n?'
    $bar=New-Object System.Windows.Forms.ProgressBar;$bar.Left=30;$bar.Top=165;$bar.Width=600;$bar.Height=18;$bar.Minimum=0;$bar.Maximum=100;$bar.Value=0
    $detail=New-Object System.Windows.Forms.TextBox;$detail.Left=30;$detail.Top=205;$detail.Width=600;$detail.Height=78;$detail.Multiline=$true;$detail.ReadOnly=$true;$detail.ScrollBars='Vertical';$detail.BackColor=[Drawing.Color]::White;$detail.Text='La instalaci?n todav?a no ha modificado la versi?n actual.'
    $f.Controls.AddRange(@($title,$ver,$status,$bar,$detail));$script:SetupForm=$f;$script:SetupProgress=$bar;$script:SetupStatus=$status;$script:SetupDetail=$detail;$f.Show();[System.Windows.Forms.Application]::DoEvents()
