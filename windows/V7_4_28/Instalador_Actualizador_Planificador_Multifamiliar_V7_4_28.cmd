# Respaldos. Data y Backups nunca se reinicializan.
Write-Step 42 'Creando respaldo recuperable de programa y datos?'
$stamp=(Get-Date -Format 'yyyyMMdd_HHmmss_fff')
if(Test-Path -LiteralPath $App){
  $appBackup=Join-Path $AppBackups "App_pre_${stamp}.zip"
  Compress-Archive -Path (Join-Path $App '*') -DestinationPath $appBackup -CompressionLevel Optimal -Force
}
$state=Join-Path $Data 'project_state.json'
if(Test-Path -LiteralPath $state){ Copy-Item -LiteralPath $state -Destination (Join-Path $DataBackups "project_state_pre_${stamp}.json") -Force }
$syncCfg=Join-Path $Data 'sync_config.json'
if(Test-Path -LiteralPath $syncCfg){ Copy-Item -LiteralPath $syncCfg -Destination (Join-Path $DataBackups "sync_config_pre_${stamp}.json") -Force }
if(Get-ChildItem -LiteralPath $Data -Force | Select-Object -First 1){ Compress-Archive -Path (Join-Path $Data '*') -DestinationPath (Join-Path $DataBackups "Data_pre_${stamp}.zip") -CompressionLevel Optimal -Force }

$previousApp=Join-Path $AppBackups "App_pre_${stamp}"
$rootFull=[IO.Path]::GetFullPath($Root).TrimEnd('\')+'\'
foreach($candidate in @($App,$stage,$previousApp)){
  if(-not [IO.Path]::GetFullPath($candidate).StartsWith($rootFull,[StringComparison]::OrdinalIgnoreCase)){ throw 'Ruta fuera de la instalacion.' }
}
$movedPrevious=$false
$runtimeStarted=$false
$serverProc=$null
$stdoutLog=Join-Path $Data 'server_startup_stdout.log'
$stderrLog=Join-Path $Data 'server_startup_stderr.log'
Remove-Item -LiteralPath $stdoutLog,$stderrLog -Force -ErrorAction SilentlyContinue
Write-Step 58 'Instalando la nueva versi?n?'
try{
  if(Test-Path -LiteralPath $App){ Move-Item -LiteralPath $App -Destination $previousApp; $movedPrevious=$true }
  Move-Item -LiteralPath $stage -Destination $App
  Write-Step 64 'Vinculando esta instalaci?n al usuario y equipo Windows?'
  $binding=Ensure-InstallationBinding

  # Iniciar y observar el proceso real del servidor.
  $server=Join-Path $App 'servidor_local.ps1'
  $psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
  $argLine='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$server+'" -NoBrowser'
  $serverProc=Start-Process -FilePath $psExe -ArgumentList $argLine -WindowStyle Hidden -PassThru -RedirectStandardOutput $stdoutLog -RedirectStandardError $stderrLog
  $runtimeStarted=$true
  Write-Step 72 'Iniciando y verificando el runtime local (hasta 60 s)?'
  $verified=Assert-Runtime $App $serverProc $stdoutLog $stderrLog
  Write-Step 84 'Runtime verificado. Finalizando configuraci?n?'
}catch{
  $reason=$_.Exception.Message
  if($runtimeStarted){
    $h=Get-Health
    if($h -and $h.serverPid){ Stop-Process -Id ([int]$h.serverPid) -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 300 }
    elseif($serverProc -and -not $serverProc.HasExited){ Stop-Process -Id $serverProc.Id -Force -ErrorAction SilentlyContinue }
  }
  if(Test-Path -LiteralPath $App){ Remove-Item -LiteralPath $App -Recurse -Force -ErrorAction SilentlyContinue }
  if($movedPrevious -and (Test-Path -LiteralPath $previousApp)){ Move-Item -LiteralPath $previousApp -Destination $App -Force; Restart-RestoredRuntime }
  throw "La instalacion fue revertida porque la verificacion final fallo: $reason"
}

# Conservar instalador para publicaci?n autom?tica.
$installerName='Instalador_Actualizador_Planificador_Multifamiliar_V'+$ExpectedVersion.Replace('.','_')+'.cmd'
$cachedInstaller=Join-Path $LocalUpdates $installerName
try { if([IO.Path]::GetFullPath($Self) -ne [IO.Path]::GetFullPath($cachedInstaller)){ Copy-Item -LiteralPath $Self -Destination $cachedInstaller -Force } } catch { Write-Warning ('No se pudo conservar copia local del instalador: '+$_.Exception.Message) }

# La carpeta App anterior ya no es necesaria para rollback despu?s de validar la nueva versi?n.
if($movedPrevious -and (Test-Path -LiteralPath $previousApp)){ Remove-Item -LiteralPath $previousApp -Recurse -Force -ErrorAction SilentlyContinue }
Trim-BackupSet $AppBackups 'App_pre_*.zip' 10
Trim-BackupSet $DataBackups 'Data_pre_*.zip' 10
Trim-BackupSet $DataBackups 'project_state_pre_*.json' 10
Trim-BackupSet $DataBackups 'sync_config_pre_*.json' 10

$postWarnings=New-Object System.Collections.Generic.List[string]
$installInfo=@{
  product=$Product; productId=$ProductId; version=$NewVersion.ToString(); installedAt=(Get-Date).ToString('o');
  appPath=$App; dataPath=$Data; origin="http://127.0.0.1:$Port"; updateMode=$mode; dataSchema='7.36'; runtimeVerified=$true
}|ConvertTo-Json -Depth 5
try { [IO.File]::WriteAllText((Join-Path $Root 'installation.json'),$installInfo,[Text.UTF8Encoding]::new($false)) } catch { $postWarnings.Add('installation.json: '+$_.Exception.Message) }

# Registrar instalaci?n exitosa para el Centro de Actualizaciones.
try {
  $historyFile=Join-Path $Data 'update_history.json';$history=@()
  if(Test-Path -LiteralPath $historyFile){ try{$history=@(Get-Content -LiteralPath $historyFile -Raw|ConvertFrom-Json)}catch{$history=@()} }
  $selfSha=(Get-FileHash -LiteralPath $Self -Algorithm SHA256).Hash.ToLowerInvariant();$fromText=if($current){' ? desde V'+$current.ToString()}else{''}
  $entry=[ordered]@{at=(Get-Date).ToString('o');event='installed';version=$NewVersion.ToString();detail=('Instalaci?n verificada ? '+$mode+$fromText);sha256=$selfSha}
  $history=@($entry)+@($history);if($history.Count -gt 100){$history=@($history|Select-Object -First 100)}
  [IO.File]::WriteAllText($historyFile,($history|ConvertTo-Json -Depth 8),[Text.UTF8Encoding]::new($false))
} catch { $postWarnings.Add('Historial de actualizaci?n: '+$_.Exception.Message) }

Write-Step 90 'Creando accesos directos y registro de usuario?'
$psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
$launcher=Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1';$supervisor=Join-Path $App 'PLANIFICADOR_SUPERVISOR.ps1';$icon=Join-Path $App 'Planificador.ico';$un=Join-Path $App 'DESINSTALAR_PLANIFICADOR.bat'
try {
  $ws=New-Object -ComObject WScript.Shell
  $desktop=[Environment]::GetFolderPath('Desktop');$lnk=$ws.CreateShortcut((Join-Path $desktop 'Planificador Multifamiliar.lnk'))
  $lnk.TargetPath=$psExe;$lnk.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"');$lnk.WorkingDirectory=$App;$lnk.Description='Planificador Multifamiliar V7';if(Test-Path -LiteralPath $icon){$lnk.IconLocation=$icon};$lnk.WindowStyle=7;$lnk.Save()
  $programs=[Environment]::GetFolderPath('Programs');$menu=Join-Path $programs 'Planificador Multifamiliar';New-Item -ItemType Directory -Path $menu -Force|Out-Null
  $lnk2=$ws.CreateShortcut((Join-Path $menu 'Planificador Multifamiliar.lnk'));$lnk2.TargetPath=$psExe;$lnk2.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"');$lnk2.WorkingDirectory=$App;$lnk2.Description='Planificador Multifamiliar V7';if(Test-Path -LiteralPath $icon){$lnk2.IconLocation=$icon};$lnk2.WindowStyle=7;$lnk2.Save()
  $startup=[Environment]::GetFolderPath('Startup');Remove-Item (Join-Path $startup 'Planificador Multifamiliar - Servidor local.lnk') -Force -ErrorAction SilentlyContinue
  $auto=$ws.CreateShortcut((Join-Path $startup 'Planificador Multifamiliar - Servicio local.lnk'));$auto.TargetPath=$psExe;$auto.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"');$auto.WorkingDirectory=$App;$auto.Description='Servicio local supervisado del Planificador Multifamiliar';if(Test-Path -LiteralPath $icon){$auto.IconLocation=$icon};$auto.WindowStyle=7;$auto.Save()
  $lnk3=$ws.CreateShortcut((Join-Path $menu 'Desinstalar Planificador.lnk'));$lnk3.TargetPath=$un;$lnk3.WorkingDirectory=$App;if(Test-Path -LiteralPath $icon){$lnk3.IconLocation=$icon};$lnk3.Save()
} catch { $postWarnings.Add('Accesos directos: '+$_.Exception.Message) }

# Supervisor: el servidor verificado ya est? activo; el supervisor mantiene recuperaci?n posterior.
try { $supArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"';Start-Process -FilePath $psExe -ArgumentList $supArgs -WindowStyle Hidden } catch { $postWarnings.Add('Supervisor: '+$_.Exception.Message) }
try {
  $reg='HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\PlanificadorMultifamiliar';New-Item $reg -Force|Out-Null
  Set-ItemProperty $reg DisplayName $Product;Set-ItemProperty $reg DisplayVersion $NewVersion.ToString();Set-ItemProperty $reg Publisher 'Planificador Multifamiliar';Set-ItemProperty $reg InstallLocation $Root;Set-ItemProperty $reg UninstallString ('"'+$un+'"');Set-ItemProperty $reg NoModify 1 -Type DWord;Set-ItemProperty $reg NoRepair 1 -Type DWord
} catch { $postWarnings.Add('Registro de Windows: '+$_.Exception.Message) }

$tempFull=[IO.Path]::GetFullPath($temp);$tempRoot=[IO.Path]::GetFullPath($env:TEMP).TrimEnd('\')+'\'
if($tempFull.StartsWith($tempRoot,[StringComparison]::OrdinalIgnoreCase) -and (Split-Path $tempFull -Leaf).StartsWith('PM_Install_')){ Remove-Item -LiteralPath $tempFull -Recurse -Force -ErrorAction SilentlyContinue }

Write-Step 100 'Actualizaci?n completada.'
try { Write-Progress -Activity ('Planificador Multifamiliar V'+$ExpectedVersion) -Completed } catch {}
$message="V$NewVersion instalada y verificada.`n`n- Conserva Data, Backups, proyecto, usuarios e históricos.`n- Cierra la PWA antes de detener el servidor durante la actualización.`n- Plan Maestro y Lookahead incluyen las correcciones funcionales V7.4.28.`n- Permisos se releen desde Supabase y registran diferencias cuando no coinciden.`n- Sectores y Work Units mantienen IDs inmutables para Campo, Validación y Real.`n- Procesos auxiliares permanecen ocultos en el flujo normal."
if($postWarnings.Count -gt 0){$message+="`n`nAvisos no fatales:`n- "+($postWarnings -join "`n- ")}
Set-SetupUi 100 'Actualizaci?n completada.' $message
Focus-SetupUi
Start-Sleep -Milliseconds 1600
Close-SetupUi

# Abrir siempre por el launcher instalado; este usa ventana tipo aplicaci?n y navegador normal solo como fallback.
$launchArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+(Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1')+'"'
Start-Process -FilePath $psExe -ArgumentList $launchArgs -WindowStyle Hidden
__PM_END_SCRIPT__
