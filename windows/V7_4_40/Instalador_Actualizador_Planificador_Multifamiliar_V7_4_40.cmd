function Sha([string]$p){ return (Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant() }
function Close-AppWindows {
  try { Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {($_.Name -match '^(msedge|chrome|brave)\.exe$') -and ([string]$_.CommandLine -match '(?i)--app=.*127\.0\.0\.1:4173')} | ForEach-Object { Stop-Process -Id ([int]$_.ProcessId) -Force -ErrorAction SilentlyContinue } } catch {}
}
function Stop-LocalRuntime {
  try { Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {($_.Name -match '^(powershell|pwsh|cmd)\.exe$') -and (([string]$_.CommandLine -match '(?i)servidor_local\.ps1|PLANIFICADOR_SUPERVISOR\.ps1') -and ([string]$_.CommandLine).IndexOf($Root,[StringComparison]::OrdinalIgnoreCase) -ge 0)} | ForEach-Object { Stop-Process -Id ([int]$_.ProcessId) -Force -ErrorAction SilentlyContinue } } catch {}
  Start-Sleep -Milliseconds 500
}
function Verify-Extracted([string]$dir){
  $vf=Join-Path $dir 'VERSION.txt';if(-not(Test-Path $vf)){throw 'El payload no contiene VERSION.txt.'}
  $v=Get-Content $vf -Raw;if($v -notmatch [regex]::Escape($ExpectedVersion)){throw "El payload declara una versión distinta: $v"}
  $mf=Join-Path $dir 'INSTALLATION_INTEGRITY.json';if(-not(Test-Path $mf)){throw 'Falta INSTALLATION_INTEGRITY.json.'}
  $j=Get-Content $mf -Raw | ConvertFrom-Json;if([string]$j.version -ne $ExpectedVersion){throw "Manifest de integridad incorrecto: $($j.version)"}
  $count=0
  foreach($prop in $j.files.PSObject.Properties){$rel=$prop.Name;$want=[string]$prop.Value;$file=Join-Path $dir ($rel -replace '/','\\');if(-not(Test-Path -LiteralPath $file -PathType Leaf)){throw "Archivo faltante: $rel"};$got=Sha $file;if($got -ne $want.ToLowerInvariant()){throw "Hash incorrecto: $rel"};$count++}
  return $count
}
