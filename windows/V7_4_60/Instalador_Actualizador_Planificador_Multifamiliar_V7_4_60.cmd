@echo off
setlocal
set "PM_INSTALLER_SELF=%~f0"
powershell.exe -NoProfile -STA -WindowStyle Hidden -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $s=[IO.File]::ReadAllText($env:PM_INSTALLER_SELF); $m=[regex]::Match($s,'(?s)\r?\n__PM_SCRIPT__\r?\n(.*?)\r?\n__PM_END_SCRIPT__'); if(-not $m.Success){throw 'Instalador incompleto: no se encontro el bloque PowerShell.'}; & ([scriptblock]::Create($m.Groups[1].Value)); exit 0 } catch { $detail=($_ | Out-String); $path=Join-Path $env:TEMP 'Planificador_V7_4_60_error_inicio.txt'; try{[IO.File]::WriteAllText($path,$detail,[Text.UTF8Encoding]::new($false))}catch{}; try { Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $f=New-Object Windows.Forms.Form; $f.Text='Planificador Multifamiliar - Error de actualizacion V7.4.60'; $f.Width=900; $f.Height=560; $f.StartPosition='CenterScreen'; $box=New-Object Windows.Forms.TextBox; $box.Multiline=$true; $box.ReadOnly=$true; $box.ScrollBars='Both'; $box.WordWrap=$false; $box.Dock='Fill'; $box.Font=New-Object Drawing.Font('Consolas',9); $box.Text=$detail; $panel=New-Object Windows.Forms.FlowLayoutPanel; $panel.Dock='Bottom'; $panel.Height=48; $copy=New-Object Windows.Forms.Button; $copy.Text='Copiar detalle'; $copy.Width=120; $copy.Add_Click({try{[Windows.Forms.Clipboard]::SetText($box.Text)}catch{}}); $save=New-Object Windows.Forms.Button; $save.Text='Guardar detalle'; $save.Width=120; $save.Add_Click({$d=New-Object Windows.Forms.SaveFileDialog; $d.FileName='Error_actualizacion_V7_4_60.txt'; $d.Filter='Texto (*.txt)|*.txt'; if($d.ShowDialog() -eq [Windows.Forms.DialogResult]::OK){[IO.File]::WriteAllText($d.FileName,$box.Text,[Text.UTF8Encoding]::new($false))}}); $open=New-Object Windows.Forms.Button; $open.Text='Abrir archivo temporal'; $open.Width=150; $open.Add_Click({try{Start-Process notepad.exe -ArgumentList ('\"'+$path+'\"')}catch{}}); $close=New-Object Windows.Forms.Button; $close.Text='Cerrar'; $close.Width=100; $close.Add_Click({$f.Close()}); $panel.Controls.AddRange(@($copy,$save,$open,$close)); $f.Controls.Add($box); $f.Controls.Add($panel); [void]$f.ShowDialog() } catch { try{Start-Process notepad.exe -ArgumentList ('\"'+$path+'\"')}catch{} }; exit 1 }"
set "PM_RC=%errorlevel%"
if not "%PM_RC%"=="0" (
  echo.
  echo La actualizacion V7.4.60 encontro un error antes de iniciar.
  echo Revise la ventana de detalle o el archivo temporal mostrado.
  echo.
