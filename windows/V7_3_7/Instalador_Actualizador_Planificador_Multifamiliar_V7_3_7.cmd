@echo off
setlocal
set "PM_INSTALLER_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:PM_INSTALLER_SELF); $m=[regex]::Match($s,'(?s)\r?\n__PM_SCRIPT__\r?\n(.*?)\r?\n__PM_END_SCRIPT__'); if(-not $m.Success){throw 'Instalador incompleto'}; & ([scriptblock]::Create($m.Groups[1].Value))"
set "PM_RC=%errorlevel%"
if not "%PM_RC%"=="0" (echo. & echo La instalacion no pudo completarse. Codigo: %PM_RC% & pause)
exit /b %PM_RC%
__PM_SCRIPT__
$ErrorActionPreference='Stop'
Add-Type -AssemblyName System.Windows.Forms

$Product='Planificador Multifamiliar'
$ProductId='planificador-multifamiliar'
$NewVersion=[version]'7.3.7'
$ExpectedVersion='7.3.7'
$Port=4173
$Self=$env:PM_INSTALLER_SELF
if([string]::IsNullOrWhiteSpace($Self) -or -not (Test-Path -LiteralPath $Self)){ throw 'No se pudo localizar el instalador.' }

$Root=Join-Path $env:LOCALAPPDATA 'PlanificadorMultifamiliar'
$App=Join-Path $Root 'App'
$Data=Join-Path $Root 'Data'
$Backups=Join-Path $Root 'Backups'
$AppBackups=Join-Path $Backups 'App'
$DataBackups=Join-Path $Backups 'Data'
$LocalUpdates=Join-Path $Root 'Updates'
New-Item -ItemType Directory -Path $Root,$Data,$Backups,$AppBackups,$DataBackups,$LocalUpdates -Force | Out-Null

function Get-PortOwner([int]$port){
  try { return (Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction Stop | Select-Object -First 1) } catch { return $null }
}
function Get-Proc([int]$pidValue){
  try { return Get-CimInstance Win32_Process -Filter "ProcessId=$pidValue" -ErrorAction Stop } catch { return $null }
}
function Test-PlanificadorProcess($proc){
  if(-not $proc){ return $false }
  $name=[string]$proc.Name
  $cmd=[string]$proc.CommandLine
  return (($name -match '^(powershell|pwsh|cmd)\.exe$') -and ($cmd -match '(?i)servidor_local\.ps1|PlanificadorMultifamiliar'))
}
function Get-Health {
  try { return Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/health" -Method Get -TimeoutSec 1 -ErrorAction Stop } catch { return $null }
}
function Stop-PlanificadorSupervisor {
  try {
    $procs=Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
      ($_.Name -match '^(powershell|pwsh)\.exe$') -and ([string]$_.CommandLine -match '(?i)PLANIFICADOR_SUPERVISOR\.ps1')
    }
    foreach($p in @($procs)){
      try { Stop-Process -Id ([int]$p.ProcessId) -Force -ErrorAction SilentlyContinue } catch {}
    }
    if($procs){ Start-Sleep -Milliseconds 500 }
  } catch {}
}
function Stop-PlanificadorListener {
  $health=Get-Health
  if($health -and $health.ok -and $health.serverPid){
    $sameProduct=([string]$health.productId -eq $ProductId)
    $looksLegacy=([string]$health.appVersion -match '^\d+(?:\.\d+){0,2}$')
    if($sameProduct -or $looksLegacy){
      Stop-Process -Id ([int]$health.serverPid) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    }
  }
  $owner=Get-PortOwner $Port
  if($owner){
    $proc=Get-Proc ([int]$owner.OwningProcess)
    if(Test-PlanificadorProcess $proc){
      Stop-Process -Id ([int]$owner.OwningProcess) -Force -ErrorAction SilentlyContinue
      Start-Sleep -Milliseconds 600
    } else {
      $pname=if($proc){[string]$proc.Name}else{'desconocido'}
      throw "El puerto local $Port esta ocupado por otra aplicacion ($pname, PID $($owner.OwningProcess)). La instalacion se detuvo para no cerrar procesos ajenos."
    }
  }
  if(Get-PortOwner $Port){ throw "El puerto local $Port sigue ocupado. Cierre la aplicacion que lo usa y vuelva a ejecutar el instalador." }
}
function Read-LogTail([string]$path,[int]$maxChars=3500){
  if(-not (Test-Path -LiteralPath $path)){ return '' }
  try {
    $t=[IO.File]::ReadAllText($path)
    if($t.Length -gt $maxChars){$t=$t.Substring($t.Length-$maxChars)}
    return $t.Trim()
  } catch { return '' }
}
function Get-StartupDiagnostic([string]$stdoutLog,[string]$stderrLog){
  $parts=@()
  $err=Read-LogTail $stderrLog
  $out=Read-LogTail $stdoutLog
  $boot=Read-LogTail (Join-Path $Data 'server_boot.log')
  if($err){$parts+=('stderr: '+$err)}
  if($out){$parts+=('stdout: '+$out)}
  if($boot){$parts+=('boot: '+$boot)}
  if($parts.Count -eq 0){return 'No se genero salida de diagnostico.'}
  return ($parts -join ' | ')
}
function Get-ByteSha256([byte[]]$bytes){
  $sha=[Security.Cryptography.SHA256]::Create()
  try { return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
  finally { $sha.Dispose() }
}
function Get-LocalHttpBytes([string]$relativePath){
  $client=New-Object System.Net.Sockets.TcpClient
  $stream=$null
  try {
    $client.ReceiveTimeout=5000
    $client.SendTimeout=5000
    $client.Connect([System.Net.IPAddress]::Loopback,$Port)
    $stream=$client.GetStream()
    $urlPath='/'+($relativePath.Replace('\','/').TrimStart('/'))
    $request="GET $urlPath HTTP/1.1`r`nHost: 127.0.0.1`r`nConnection: close`r`nCache-Control: no-cache`r`n`r`n"
    $requestBytes=[Text.Encoding]::ASCII.GetBytes($request)
    $stream.Write($requestBytes,0,$requestBytes.Length)
    $stream.Flush()

    $ms=New-Object IO.MemoryStream
    try {
      $buffer=New-Object byte[] 8192
      while(($read=$stream.Read($buffer,0,$buffer.Length)) -gt 0){ $ms.Write($buffer,0,$read) }
      $raw=$ms.ToArray()
    } finally { $ms.Dispose() }

    if($raw.Length -lt 12){ throw "Respuesta HTTP local incompleta al verificar $relativePath." }
    $headerEnd=-1
    for($i=0;$i -le $raw.Length-4;$i++){
      if($raw[$i] -eq 13 -and $raw[$i+1] -eq 10 -and $raw[$i+2] -eq 13 -and $raw[$i+3] -eq 10){
        $headerEnd=$i
        break
      }
    }
    if($headerEnd -lt 0){ throw "Respuesta HTTP local sin cabeceras validas al verificar $relativePath." }

    $header=[Text.Encoding]::ASCII.GetString($raw,0,$headerEnd)
    $statusLine=($header -split "`r`n")[0]
    if($statusLine -notmatch '^HTTP/1\.[01]\s+(\d{3})\b'){ throw "Estado HTTP local no reconocible al verificar $relativePath." }
    $status=[int]$Matches[1]
    if($status -ne 200){ throw "HTTP local $($status) al verificar $relativePath." }

    $bodyStart=$headerEnd+4
    $bodyLength=$raw.Length-$bodyStart
    if($bodyLength -le 0){ return [byte[]]@() }
    $body=New-Object byte[] $bodyLength
    [Array]::Copy($raw,$bodyStart,$body,0,$bodyLength)
    return [byte[]]$body
  } finally {
    if($stream){ try{$stream.Dispose()}catch{} }
    if($client){ try{$client.Close()}catch{} }
  }
}
function Assert-ServedFile([string]$expectedRoot,[string]$relativePath){
  $local=Join-Path $expectedRoot $relativePath
  if(-not (Test-Path -LiteralPath $local -PathType Leaf)){ throw "No existe el archivo local a verificar: $relativePath" }
  $expected=(Get-FileHash -LiteralPath $local -Algorithm SHA256).Hash.ToLowerInvariant()
  $served=Get-LocalHttpBytes $relativePath
  if($null -eq $served -or $served.Length -le 0){ throw "El servidor devolvio vacio al verificar $relativePath." }
  $actual=Get-ByteSha256 ([byte[]]$served)
  if($actual -ne $expected){ throw "El archivo servido no coincide con el instalado: $relativePath (esperado $expected, recibido $actual)." }
}
function Assert-Runtime([string]$expectedRoot,$serverProc,[string]$stdoutLog,[string]$stderrLog){
  $health=$null
  for($i=0;$i -lt 120;$i++){
    Start-Sleep -Milliseconds 250
    if($serverProc){
      try{$serverProc.Refresh()}catch{}
      if($serverProc.HasExited){
        $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
        throw "El proceso del servidor local termino antes de responder (codigo $($serverProc.ExitCode)). $diag"
      }
    }
    $health=Get-Health
    if($health -and $health.ok){ break }
  }
  if(-not $health -or -not $health.ok){
    $diag=Get-StartupDiagnostic $stdoutLog $stderrLog
    throw "El servidor local nuevo no respondio despues de la espera de arranque. $diag"
  }
  if([string]$health.productId -ne $ProductId){ throw "El puerto $Port responde con otro producto." }
  if([string]$health.appVersion -ne $ExpectedVersion){ throw "La version servida es $($health.appVersion), no V$($ExpectedVersion)." }
  try{$servedRoot=[IO.Path]::GetFullPath([string]$health.appRoot)}catch{throw 'El servidor no informo una ruta de aplicacion valida.'}
  if(-not $servedRoot.Equals([IO.Path]::GetFullPath($expectedRoot),[StringComparison]::OrdinalIgnoreCase)){ throw 'El servidor activo no corresponde a la carpeta App recien instalada.' }
  foreach($file in @('index.html','app.js','styles.css','manifest.webmanifest','sw.js')){ Assert-ServedFile $expectedRoot $file }
  return $health
}

$current=$null
$versionFile=Join-Path $App 'VERSION.txt'
if(Test-Path -LiteralPath $versionFile){
  $txt=Get-Content -LiteralPath $versionFile -Raw
  if($txt -match 'V(\d+\.\d+(?:\.\d+)?)'){ try{$current=[version]$Matches[1]}catch{} }
}
if($current -and $current -gt $NewVersion){
  [System.Windows.Forms.MessageBox]::Show("Hay una version mas nueva instalada ($current).`n`nEste instalador es V$NewVersion y no puede hacer downgrade.",$Product,[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Warning)|Out-Null
  exit 3
}
$mode=if(-not $current){'Instalacion'}elseif($current -eq $NewVersion){'Reparacion'}else{'Actualizacion'}

# Extraer y verificar el payload antes de tocar App.
$lines=[IO.File]::ReadAllLines($Self)
$marker='__PM_PAYLOAD__'
$idx=[Array]::IndexOf($lines,$marker)
if($idx -lt 0){ throw 'El instalador esta incompleto: no contiene payload.' }
$b64=(-join $lines[($idx+1)..($lines.Length-1)]).Trim()
$temp=Join-Path $env:TEMP ('PM_Install_'+[guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $temp -Force | Out-Null
$zip=Join-Path $temp 'payload.zip'
[IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($b64))
if((Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash.ToLowerInvariant() -ne '0225b90ddac218eabaca19f0ccc79b5ea36ec585d33579b56c4cb0a452813145'){ throw 'El paquete embebido esta danado. No se modifico la instalacion.' }
$extract=Join-Path $temp 'payload'
Expand-Archive -LiteralPath $zip -DestinationPath $extract -Force

foreach($required in @('app.js','index.html','styles.css','servidor_local.ps1','VERSION.txt','manifest.webmanifest','sw.js','cache_reset.html','INSTALLATION_INTEGRITY.json')){
  if(-not (Test-Path -LiteralPath (Join-Path $extract $required))){ throw "Paquete incompleto: $required" }
}
$integrity=(Get-Content -LiteralPath (Join-Path $extract 'INSTALLATION_INTEGRITY.json') -Raw | ConvertFrom-Json)
if([string]$integrity.productId -ne $ProductId -or [string]$integrity.version -ne $ExpectedVersion){ throw 'Manifiesto de integridad de otra version o producto.' }
foreach($prop in $integrity.files.PSObject.Properties){
  $p=Join-Path $extract ([string]$prop.Name)
  if(-not (Test-Path -LiteralPath $p -PathType Leaf)){ throw "Archivo de integridad faltante: $($prop.Name)" }
  $actual=(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant()
  if($actual -ne ([string]$prop.Value).ToLowerInvariant()){ throw "Integridad incorrecta: $($prop.Name)" }
}
$versionText=Get-Content -LiteralPath (Join-Path $extract 'VERSION.txt') -Raw
if($versionText -notmatch ('Planificador Multifamiliar V'+[regex]::Escape($ExpectedVersion))){ throw "VERSION.txt no corresponde a V$($ExpectedVersion)." }

# Resolver supervisor/servidor previos antes de reemplazar App.
Stop-PlanificadorSupervisor
Stop-PlanificadorListener

$stage=Join-Path $Root ('App_staging_'+[guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $stage -Force | Out-Null
Copy-Item -Path (Join-Path $extract '*') -Destination $stage -Recurse -Force

# Respaldos. Data y Backups nunca se reinicializan.
$stamp=(Get-Date -Format 'yyyyMMdd_HHmmss_fff')
if(Test-Path -LiteralPath $App){
  $appBackup=Join-Path $AppBackups "App_pre_${stamp}.zip"
  Compress-Archive -Path (Join-Path $App '*') -DestinationPath $appBackup -CompressionLevel Optimal -Force
}
$state=Join-Path $Data 'project_state.json'
if(Test-Path -LiteralPath $state){ Copy-Item -LiteralPath $state -Destination (Join-Path $DataBackups "project_state_pre_${stamp}.json") -Force }
$syncCfg=Join-Path $Data 'sync_config.json'
if(Test-Path -LiteralPath $syncCfg){ Copy-Item -LiteralPath $syncCfg -Destination (Join-Path $DataBackups "sync_config_pre_${stamp}.json") -Force }
if(Get-ChildItem -LiteralPath $Data -Force | Select-Object -First 1){ Compress-Archive -Path (Join-Path $Data '*') -DestinationPath (Join-Path $DataBackups "Data_pre_${stamp}.zip") -CompressionLevel Optimal -Force }

$previousApp=Join-Path $AppBackups "App_pre_${stamp}"
$rootFull=[IO.Path]::GetFullPath($Root).TrimEnd('\')+'\'
foreach($candidate in @($App,$stage,$previousApp)){
  if(-not [IO.Path]::GetFullPath($candidate).StartsWith($rootFull,[StringComparison]::OrdinalIgnoreCase)){ throw 'Ruta fuera de la instalacion.' }
}
$movedPrevious=$false
$runtimeStarted=$false
$serverProc=$null
$stdoutLog=Join-Path $Data 'server_startup_stdout.log'
$stderrLog=Join-Path $Data 'server_startup_stderr.log'
Remove-Item -LiteralPath $stdoutLog,$stderrLog -Force -ErrorAction SilentlyContinue
try{
  if(Test-Path -LiteralPath $App){ Move-Item -LiteralPath $App -Destination $previousApp; $movedPrevious=$true }
  Move-Item -LiteralPath $stage -Destination $App

  # Iniciar y observar el proceso real del servidor.
  $server=Join-Path $App 'servidor_local.ps1'
  $psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
  $argLine='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$server+'" -NoBrowser'
  $serverProc=Start-Process -FilePath $psExe -ArgumentList $argLine -PassThru -RedirectStandardOutput $stdoutLog -RedirectStandardError $stderrLog
  $runtimeStarted=$true
  $verified=Assert-Runtime $App $serverProc $stdoutLog $stderrLog
}catch{
  $reason=$_.Exception.Message
  if($runtimeStarted){
    $h=Get-Health
    if($h -and $h.serverPid){ Stop-Process -Id ([int]$h.serverPid) -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 300 }
    elseif($serverProc -and -not $serverProc.HasExited){ Stop-Process -Id $serverProc.Id -Force -ErrorAction SilentlyContinue }
  }
  if(Test-Path -LiteralPath $App){ Remove-Item -LiteralPath $App -Recurse -Force -ErrorAction SilentlyContinue }
  if($movedPrevious -and (Test-Path -LiteralPath $previousApp)){ Move-Item -LiteralPath $previousApp -Destination $App -Force }
  throw "La instalacion fue revertida porque la verificacion final fallo: $reason"
}

# Conservar instalador para publicacion automatica.
$installerName='Instalador_Actualizador_Planificador_Multifamiliar_V'+$ExpectedVersion.Replace('.','_')+'.cmd'
$cachedInstaller=Join-Path $LocalUpdates $installerName
if([IO.Path]::GetFullPath($Self) -ne [IO.Path]::GetFullPath($cachedInstaller)){ Copy-Item -LiteralPath $Self -Destination $cachedInstaller -Force }

$installInfo=@{
  product=$Product; productId=$ProductId; version=$NewVersion.ToString(); installedAt=(Get-Date).ToString('o');
  appPath=$App; dataPath=$Data; origin="http://127.0.0.1:$Port"; updateMode=$mode; dataSchema='7.29'; runtimeVerified=$true
}|ConvertTo-Json -Depth 5
[IO.File]::WriteAllText((Join-Path $Root 'installation.json'),$installInfo,[Text.UTF8Encoding]::new($false))

# Registrar instalación exitosa para el Centro de Actualizaciones V1.
try {
  $historyFile=Join-Path $Data 'update_history.json'
  $history=@()
  if(Test-Path -LiteralPath $historyFile){ try{$history=@(Get-Content -LiteralPath $historyFile -Raw|ConvertFrom-Json)}catch{$history=@()} }
  $selfSha=(Get-FileHash -LiteralPath $Self -Algorithm SHA256).Hash.ToLowerInvariant()
  $fromText=if($current){' · desde V'+$current.ToString()}else{''}
  $entry=[ordered]@{at=(Get-Date).ToString('o');event='installed';version=$NewVersion.ToString();detail=('Instalación verificada · '+$mode+$fromText);sha256=$selfSha}
  $history=@($entry)+@($history)
  if($history.Count -gt 100){$history=@($history|Select-Object -First 100)}
  [IO.File]::WriteAllText($historyFile,($history|ConvertTo-Json -Depth 8),[Text.UTF8Encoding]::new($false))
} catch {}


# Accesos directos y servicio supervisor solo despues de verificar runtime.
$ws=New-Object -ComObject WScript.Shell
$psExe=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
$launcher=Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1'
$supervisor=Join-Path $App 'PLANIFICADOR_SUPERVISOR.ps1'
$icon=Join-Path $App 'Planificador.ico'

$desktop=[Environment]::GetFolderPath('Desktop')
$lnk=$ws.CreateShortcut((Join-Path $desktop 'Planificador Multifamiliar.lnk'))
$lnk.TargetPath=$psExe
$lnk.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"')
$lnk.WorkingDirectory=$App
$lnk.Description='Planificador Multifamiliar V7'
if(Test-Path -LiteralPath $icon){$lnk.IconLocation=$icon}
$lnk.WindowStyle=7
$lnk.Save()

$programs=[Environment]::GetFolderPath('Programs')
$menu=Join-Path $programs 'Planificador Multifamiliar'
New-Item -ItemType Directory -Path $menu -Force | Out-Null
$lnk2=$ws.CreateShortcut((Join-Path $menu 'Planificador Multifamiliar.lnk'))
$lnk2.TargetPath=$psExe
$lnk2.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$launcher+'"')
$lnk2.WorkingDirectory=$App
$lnk2.Description='Planificador Multifamiliar V7'
if(Test-Path -LiteralPath $icon){$lnk2.IconLocation=$icon}
$lnk2.WindowStyle=7
$lnk2.Save()

$startup=[Environment]::GetFolderPath('Startup')
Remove-Item (Join-Path $startup 'Planificador Multifamiliar - Servidor local.lnk') -Force -ErrorAction SilentlyContinue
$auto=$ws.CreateShortcut((Join-Path $startup 'Planificador Multifamiliar - Servicio local.lnk'))
$auto.TargetPath=$psExe
$auto.Arguments=('-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"')
$auto.WorkingDirectory=$App
$auto.Description='Servicio local supervisado del Planificador Multifamiliar'
if(Test-Path -LiteralPath $icon){$auto.IconLocation=$icon}
$auto.WindowStyle=7
$auto.Save()

$un=Join-Path $App 'DESINSTALAR_PLANIFICADOR.bat'
$lnk3=$ws.CreateShortcut((Join-Path $menu 'Desinstalar Planificador.lnk'))
$lnk3.TargetPath=$un
$lnk3.WorkingDirectory=$App
if(Test-Path -LiteralPath $icon){$lnk3.IconLocation=$icon}
$lnk3.Save()

$supArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+$supervisor+'"'
Start-Process -FilePath $psExe -ArgumentList $supArgs -WindowStyle Hidden


$reg='HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\PlanificadorMultifamiliar'
New-Item $reg -Force | Out-Null
Set-ItemProperty $reg DisplayName $Product
Set-ItemProperty $reg DisplayVersion $NewVersion.ToString()
Set-ItemProperty $reg Publisher 'Planificador Multifamiliar'
Set-ItemProperty $reg InstallLocation $Root
Set-ItemProperty $reg UninstallString ('"'+$un+'"')
Set-ItemProperty $reg NoModify 1 -Type DWord
Set-ItemProperty $reg NoRepair 1 -Type DWord

$tempFull=[IO.Path]::GetFullPath($temp)
$tempRoot=[IO.Path]::GetFullPath($env:TEMP).TrimEnd('\')+'\'
if($tempFull.StartsWith($tempRoot,[StringComparison]::OrdinalIgnoreCase) -and (Split-Path $tempFull -Leaf).StartsWith('PM_Install_')){ Remove-Item -LiteralPath $tempFull -Recurse -Force -ErrorAction SilentlyContinue }

$message="V$NewVersion instalada y verificada correctamente.`n`nV7.3.7:`n- Publicación GitHub por Contents API (sin Git Trees)`n- Rama real detectada y validada`n- Windows + PWA + Cloudflare + Supabase`n- Esquema 7.29 sin cambios`n- Data y Backups preservados`n`nNo requiere SQL nuevo."
[System.Windows.Forms.MessageBox]::Show($message,$Product,[System.Windows.Forms.MessageBoxButtons]::OK,[System.Windows.Forms.MessageBoxIcon]::Information)|Out-Null

$launchArgs='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "'+(Join-Path $App 'PLANIFICADOR_LAUNCHER.ps1')+'"'
Start-Process -FilePath (Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe') -ArgumentList $launchArgs -WindowStyle Hidden
__PM_END_SCRIPT__
